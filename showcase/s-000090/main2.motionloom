<!-- S90 / LEATHER SHOE / Static studio render-style reel, two seconds each. -->
<Graph fps={30} duration="16s" size={[3840,2160]}>
  <RenderStyle id="shoe_filmic_physical">
    <SurfaceStyle shading="filmic_physical_v1" specular="1" roughnessBias="0" />
    <OutlineStyle enabled="false" />
    <LightingStyle ambientIntensity="0" ambientColor="#FFFFFF" shadowStyle="soft" />
    <PostStyle toneMapping="filmic_aces_v1" exposure="1" saturation="1" contrast="1" whiteBalance="6500" bloomIntensity="0" />
  </RenderStyle>
  <RenderStyle id="shoe_physical">
    <SurfaceStyle shading="physical" specular="1" roughnessBias="0" />
    <OutlineStyle enabled="false" />
    <LightingStyle ambientIntensity="0" ambientColor="#FFFFFF" shadowStyle="soft" />
    <PostStyle toneMapping="aces" exposure="1" saturation="1" contrast="1" whiteBalance="6500" bloomIntensity="0" />
  </RenderStyle>
  <RenderStyle id="shoe_stylized">
    <SurfaceStyle shading="stylized" diffuseWrap="0.35" specular="0.12" />
    <OutlineStyle enabled="false" />
    <LightingStyle ambientIntensity="0" ambientColor="#FFFFFF" shadowStyle="soft" />
    <PostStyle toneMapping="aces" exposure="1" saturation="1.05" contrast="1" whiteBalance="6500" bloomIntensity="0" />
  </RenderStyle>
  <RenderStyle id="shoe_toon">
    <SurfaceStyle shading="toon" shadingSteps="3" diffuseWrap="0.2" rimLight="0.12" specular="0.05" />
    <OutlineStyle enabled="false" />
    <LightingStyle ambientIntensity="0" ambientColor="#FFFFFF" shadowStyle="soft" />
    <PostStyle toneMapping="aces" exposure="1" saturation="1.08" contrast="1.05" whiteBalance="6500" bloomIntensity="0" />
  </RenderStyle>
  <RenderStyle id="shoe_clay">
    <SurfaceStyle shading="clay" specular="0.08" roughnessBias="0.18" />
    <OutlineStyle enabled="false" />
    <LightingStyle ambientIntensity="0" ambientColor="#FFFFFF" shadowStyle="soft" />
    <PostStyle toneMapping="aces" exposure="1" saturation="1" contrast="1" whiteBalance="6500" bloomIntensity="0" />
  </RenderStyle>
  <RenderStyle id="shoe_cel">
    <SurfaceStyle shading="cel" shadingSteps="2" diffuseWrap="0" rimLight="4" rimPower="0.1" specular="0" saturation="3" shadowThreshold="0.5" shadowFeather="0.001" shadowColor="#000000" />
    <OutlineStyle enabled="true" color="#000000" width="12" method="geometry" distanceMode="screen" />
    <LightingStyle ambientIntensity="0" ambientColor="#FFFFFF" shadowStyle="hard" />
    <PostStyle toneMapping="aces" exposure="1" saturation="1.4" contrast="1.2" whiteBalance="6500" bloomIntensity="0" />
  </RenderStyle>
  <RenderStyle id="shoe_ink">
    <SurfaceStyle shading="ink_wash_soft_v1" specular="1" roughnessBias="0" />
    <OutlineStyle enabled="false" />
    <LightingStyle ambientIntensity="0" ambientColor="#FFFFFF" shadowStyle="soft" />
    <PostStyle toneMapping="aces" exposure="1" saturation="1" contrast="1" whiteBalance="6500" bloomIntensity="0" />
    <ColorStyle tint="#FFF7EC" tintStrength="0.02" saturation="1.02" />
    <ToneStyle exposure="1" contrast="1" shadowColor="#3A424B" highlightColor="#FFF3DF" toneStrength="0.08" />
  </RenderStyle>
  <RenderStyle id="shoe_grey_model">
    <SurfaceStyle shading="clay" specular="0" roughnessBias="1" />
    <ColorStyle saturation="0" />
  </RenderStyle>

  <Assets>
    <!-- Base color and metallic/roughness textures are embedded in this GLB. -->
    <ModelAsset id="shoe_asset" src="assets/priest_karol_wojtyas_sports_shoes.glb" />
    <!-- Original Blender-authored, scene-linear studio IBL and metre-scale cyclorama. -->
    <ImageAsset id="studio_environment" src="assets/motionloom_product_studio.exr" />
    <ModelAsset id="studio_cyclorama_asset" src="assets/motionloom_product_cyclorama.glb" />
  </Assets>

  <Background color="#B8B5AF" />
  <Scene id="S90LeatherShoe" renderStyle="shoe_filmic_physical">
    <Timeline>
      <Track id="world" space="3d">
        <Sequence from="0s" duration="16s" out="hold">
          <CompositeGroup id="shoe_studio" space="3d" depth="true" format="rgba16f">
            <Camera3D id="shoe_camera" position={[0.4,0.26,0.53]} target={[0,0.105,0]} fov="35" depthOfField="true" focusDistance="0.685" maxBlur="0" />
            <EnvironmentLight id="studio_ibl" asset="studio_environment" mapping="equirectangular" rotationY="0" intensity="0.08" visible="false" backgroundIntensity="0" backgroundBlur="0.12" diffuseIntensity="0.65" specularIntensity="1.2" />
            <!-- Broad photographic sources create leather highlights; dimensions are metres. -->
            <RectAreaLight id="key" position={[-0.35,0.48,0.42]} direction={[0.35,-0.38,-0.42]} color="#FFF1E2" intensity="50" width="0.32" height="0.24" range="3" castShadow="true" shadowStrength="0.9" />
            <RectAreaLight id="fill" position={[0.42,0.28,0.32]} direction={[-0.42,-0.18,-0.32]} color="#E2ECF7" intensity="10" width="0.42" height="0.30" range="3" />
            <RectAreaLight id="rim" position={[-0.30,0.35,-0.38]} direction={[0.30,-0.25,0.38]} color="#FFE0BF" intensity="22" width="0.24" height="0.18" range="3" />
            <AmbientOcclusion radius="0.06" intensity="0.35" />
            <ContactShadow distance="0.08" softness="0.8" intensity="0.35" />
            <Model id="studio_cyclorama" asset="studio_cyclorama_asset" position={[0,0,0]} scaleMode="none" scale="1" receiveShadow="true" />
            <!-- The source scan is about 41 units wide; 0.01 makes the pair about 41 cm. -->
            <Model id="shoe" asset="shoe_asset" position={[-0.004,0.1163,0.0058]} scaleMode="none" scale="0.01" castShadow="true" receiveShadow="true" />
          </CompositeGroup>
        </Sequence>
      </Track>
    </Timeline>
  </Scene>
  <AnimationTarget node="S90LeatherShoe" property="renderStyle">
    <Key time="0s" value="shoe_filmic_physical" />
    <Key time="2s" value="shoe_physical" />
    <Key time="4s" value="shoe_stylized" />
    <Key time="6s" value="shoe_toon" />
    <Key time="8s" value="shoe_clay" />
    <Key time="10s" value="shoe_cel" />
    <Key time="12s" value="shoe_ink" />
    <Key time="14s" value="shoe_grey_model" />
  </AnimationTarget>
  <Present from="S90LeatherShoe" />
</Graph>
