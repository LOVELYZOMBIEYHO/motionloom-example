<!-- S80: Scene-owned RenderStyle. Shared assets, camera and light rig; no external assets. -->
<Graph fps={30} duration="30s" size={[1280,720]}>
  <Background color="#00000000" />
  <RenderStyle id="s80_physical">
    <SurfaceStyle shading="physical" />
    <PostStyle toneMapping="aces" exposure="1.0" saturation="1.0" contrast="1.0" />
  </RenderStyle>
  <RenderStyle id="s80_stylized">
    <SurfaceStyle shading="stylized" diffuseWrap="0.35" specular="0.12" />
    <PostStyle toneMapping="aces" exposure="1.0" saturation="1.0" contrast="1.0" />
  </RenderStyle>
  <RenderStyle id="s80_toon_two">
    <SurfaceStyle shading="toon" shadingSteps="2" diffuseWrap="0" specular="0" />
