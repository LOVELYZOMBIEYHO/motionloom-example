<Graph fps={30} duration="8s" size={[1920,1080]} renderSize={[1920,1080]}>
  <Background color="#050812" />

  <Scene id="declarative_layout_showcase">
    <Timeline>
      <Track id="layout_showcase_track" space="screen" z="0">
        <Sequence from="0s" duration="2.5s" out="hide">
          <Layer id="row_layout_layer">
            <Text value="LAYOUT / ROW" x="960" y="120" fontSize="70"
                  fontWeight="900" color="#F8FAFC" />
            <Text value="CHILD POSITIONS ARE GENERATED BY ITEM WIDTH + GAP" x="960" y="180"
                  fontSize="23" color="#67E8F9" />
            <Group opacity={curve("0:0:linear, 0.35:1:ease_out, 2.2:1:linear, 2.5:0:ease_in")}>
              <Layout id="era_row" mode="row" x="130" y="320"
                      itemWidth="300" itemHeight="440" gap="50">
                <Group>
                  <Rect x="0" y="0" width="300" height="440" radius="30" color="#3B2A1C" />
                  <Text value="1980" x="150" y="100" fontSize="44" color="#FFF1D6" />
                  <Rect x="45" y="340" width="12" height="24" color="#F4C68B" />
                </Group>
                <Group>
                  <Rect x="0" y="0" width="300" height="440" radius="30" color="#082F49" />
                  <Text value="2000" x="150" y="100" fontSize="44" color="#E2F8FF" />
                  <Rect x="45" y="340" width="120" height="24" color="#22D3EE" />
                </Group>
                <Group>
                  <Rect x="0" y="0" width="300" height="440" radius="30" color="#1E1B4B" />
                  <Text value="2025" x="150" y="100" fontSize="44" color="#F5F3FF" />
                  <Rect x="45" y="340" width="92" height="24" color="#A78BFA" />
                </Group>
                <Group>
                  <Rect x="0" y="0" width="300" height="440" radius="30" color="#052E2B" />
                  <Text value="2035" x="150" y="100" fontSize="44" color="#ECFDF5" />
                  <Rect x="45" y="340" width="102" height="24" color="#4ADE80" />
                </Group>
                <Group>
                  <Rect x="0" y="0" width="300" height="440" radius="30" color="#E6FFFA" />
                  <Text value="2050" x="150" y="100" fontSize="44" color="#083344" />
                  <Rect x="45" y="340" width="192" height="24" color="#14B8A6" />
                </Group>
              </Layout>
            </Group>
          </Layer>
        </Sequence>

        <Sequence from="2.5s" duration="2.5s" out="hide">
          <Layer id="column_layout_layer">
            <Text value="LAYOUT / COLUMN" x="960" y="100" fontSize="66"
                  fontWeight="900" color="#F8FAFC" />
            <Group opacity={curve("0:0:linear, 0.35:1:ease_out, 2.2:1:linear, 2.5:0:ease_in")}>
              <Layout id="metric_column" mode="column" x="280" y="220"
                      itemWidth="1360" itemHeight="150" gap="28">
                <Group>
                  <Rect x="0" y="0" width="1360" height="150" radius="26" color="#071B2D" stroke="#22D3EE" strokeWidth="3" />
                  <Text value="POPULATION" x="80" y="85" fontSize="31" color="#A5F3FC" />
                  <Rect x="430" y="63" width="780" height="24" color="#164E63" />
                  <Rect x="430" y="63" width="620" height="24" color="#22D3EE" />
                </Group>
                <Group>
                  <Rect x="0" y="0" width="1360" height="150" radius="26" color="#18133A" stroke="#A78BFA" strokeWidth="3" />
                  <Text value="MOBILITY" x="80" y="85" fontSize="31" color="#DDD6FE" />
                  <Rect x="430" y="63" width="780" height="24" color="#312E81" />
                  <Rect x="430" y="63" width="470" height="24" color="#A78BFA" />
                </Group>
                <Group>
                  <Rect x="0" y="0" width="1360" height="150" radius="26" color="#052E2B" stroke="#4ADE80" strokeWidth="3" />
                  <Text value="GREEN ENERGY" x="80" y="85" fontSize="31" color="#BBF7D0" />
                  <Rect x="430" y="63" width="780" height="24" color="#14532D" />
                  <Rect x="430" y="63" width="710" height="24" color="#4ADE80" />
                </Group>
                <Group>
                  <Rect x="0" y="0" width="1360" height="150" radius="26" color="#3B1425" stroke="#F472B6" strokeWidth="3" />
                  <Text value="NETWORK" x="80" y="85" fontSize="31" color="#FBCFE8" />
                  <Rect x="430" y="63" width="780" height="24" color="#831843" />
                  <Rect x="430" y="63" width="550" height="24" color="#F472B6" />
                </Group>
              </Layout>
            </Group>
          </Layer>
        </Sequence>

        <Sequence from="5s" duration="3s" out="hold">
          <Layer id="grid_layout_layer">
            <Text value="LAYOUT / GRID" x="960" y="90" fontSize="66"
                  fontWeight="900" color="#F8FAFC" />
            <Text value="3 COLUMNS · 2 ROWS · ONE DECLARATIVE CONTAINER" x="960" y="145"
                  fontSize="23" color="#67E8F9" />
            <Group opacity={curve("0:0:linear, 0.4:1:ease_out, 3:1:linear")}>
              <Layout id="capability_grid" mode="grid" x="210" y="220"
                      columns="3" itemWidth="460" itemHeight="300" gap="60">
                <Group>
                  <Rect x="0" y="0" width="460" height="300" radius="32" color="#082F49" />
                  <Text value="CAMERA" x="230" y="95" fontSize="38" color="#E2F8FF" />
                  <Circle x="230" y="190" radius="50" fill="none" stroke="#22D3EE" strokeWidth="8" />
                </Group>
                <Group>
                  <Rect x="0" y="0" width="460" height="300" radius="32" color="#1E1B4B" />
                  <Text value="MORPH" x="230" y="95" fontSize="38" color="#F5F3FF" />
                  <Path d="M 150 220 L 230 145 L 310 220 Z" fill="#A78BFA" stroke="none" />
                </Group>
                <Group>
                  <Rect x="0" y="0" width="460" height="300" radius="32" color="#052E2B" />
                  <Text value="REPEAT" x="230" y="95" fontSize="38" color="#ECFDF5" />
                  <Repeat count="7" x="125" y="190" xStep="34">
                    <Circle x="0" y="0" radius="9" color="#4ADE80" />
                  </Repeat>
                </Group>
                <Group>
                  <Rect x="0" y="0" width="460" height="300" radius="32" color="#3B1425" />
                  <Text value="MASK" x="230" y="95" fontSize="38" color="#FCE7F3" />
                  <Rect x="130" y="160" width="200" height="65" radius="32" color="#F472B6" />
                </Group>
                <Group>
                  <Rect x="0" y="0" width="460" height="300" radius="32" color="#3B2A1C" />
                  <Text value="PATH" x="230" y="95" fontSize="38" color="#FFF1D6" />
                  <Path d="M 100 220 C 180 120 280 270 360 155" fill="none" stroke="#F4C68B" strokeWidth="8" />
                </Group>
                <Group>
                  <Rect x="0" y="0" width="460" height="300" radius="32" color="#073042" />
                  <Text value="TEXT" x="230" y="95" fontSize="38" color="#ECFEFF" />
                  <Text value="Aa" x="230" y="220" fontSize="86" fontWeight="900" color="#67E8F9" />
                </Group>
              </Layout>
            </Group>
          </Layer>
        </Sequence>
      </Track>
    </Timeline>
  </Scene>

  <Present from="declarative_layout_showcase" />
</Graph>
