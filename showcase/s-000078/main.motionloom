<!-- S78 · PRIMITIVE ASSET COMPARISON GALLERY · 14 s · 420 frames -->
<Graph fps={30} duration="14s" size={[1920,1080]} renderSize={[1920,1080]}>
  <Assets>
    <MaterialAsset id="s78_gallery_floor" shading="pbr" baseColor="#111A2B" metallic="0.24" roughness="0.34" specular="0.76" />
    <MaterialAsset id="s78_pedestal_mat" shading="pbr" baseColor="#18243A" metallic="0.58" roughness="0.22" specular="0.9" />
    <MaterialAsset id="s78_compare_mat" shading="pbr" baseColor="#D9783D" metallic="0.72" roughness="0.24" specular="0.94" />
    <MaterialAsset id="s78_surface_mat" shading="pbr" baseColor="#DDEAFF" metallic="0.12" roughness="0.2" specular="0.96" />
    <MaterialAsset id="s78_shape_mat" shading="pbr" baseColor="#58CFE8" metallic="0.48" roughness="0.2" specular="0.92" />
    <MaterialAsset id="s78_hero_mat" shading="pbr" baseColor="#D86A32" metallic="0.9" roughness="0.18" specular="0.98" />
    <MaterialAsset id="s78_hero_white" shading="pbr" baseColor="#EFF7FF" metallic="0.06" roughness="0.14" specular="0.96" />
    <MaterialAsset id="s78_glow" shading="pbr" baseColor="#79F2FF" metallic="0.08" roughness="0.12" specular="0.94"
                   emissive="#4DE5FF" emissiveStrength="4.2" />

    <PrimitiveAsset id="s78_floor" shape="roundedBox" size={[18,0.28,39]} radius="0.1" segments="3"
                    material="s78_gallery_floor" collision="solid" collider="box" />
    <PrimitiveAsset id="s78_pedestal" shape="roundedBox" size={[2.1,0.38,1.8]} radius="0.14" segments="4"
                    material="s78_pedestal_mat">
      <Modifiers>
        <WeightedNormals strength="1" keepSharpEdges="true" />
      </Modifiers>
      <MeshBuild topology="quads" quality="high" maxTriangles="4000" />
      <LOD mode="auto" levels="3" preserveSilhouette="true" />
    </PrimitiveAsset>

    <!-- Row 1: one source form, then one clearly isolated deformation. -->
    <PrimitiveAsset id="s78_mod_base" shape="roundedBox" size={[0.9,2.4,0.9]} radius="0.16" segments="5" material="s78_compare_mat">
      <MeshBuild topology="quads" quality="high" maxTriangles="5000" />
    </PrimitiveAsset>
    <PrimitiveAsset id="s78_mod_taper" shape="roundedBox" size={[0.9,2.4,0.9]} radius="0.16" segments="5" material="s78_compare_mat">
      <Modifiers>
        <Taper axis="y" start="1.3" end="0.42" />
      </Modifiers>
      <MeshBuild topology="quads" quality="high" maxTriangles="5000" />
    </PrimitiveAsset>
    <PrimitiveAsset id="s78_mod_bend" shape="roundedBox" size={[0.9,2.4,0.9]} radius="0.16" segments="6" material="s78_compare_mat">
      <Modifiers>
        <Subdivision levels="1" />
        <Bend axis="y" angle="62" pivot={[0,-1.2,0]} />
      </Modifiers>
      <MeshBuild topology="quads" quality="high" maxTriangles="18000" />
    </PrimitiveAsset>
    <PrimitiveAsset id="s78_mod_twist" shape="roundedBox" size={[0.9,2.4,0.9]} radius="0.16" segments="6" material="s78_compare_mat">
      <Modifiers>
        <Subdivision levels="1" />
        <Twist axis="y" angle="105" />
      </Modifiers>
      <MeshBuild topology="quads" quality="high" maxTriangles="18000" />
    </PrimitiveAsset>

    <!-- Row 2: cumulative mesh and normal processing on the same low-poly source. -->
    <PrimitiveAsset id="s78_surface_raw" shape="ellipsoid" radii={[0.82,1.12,0.82]} segments="10" rings="6" material="s78_surface_mat" />
    <PrimitiveAsset id="s78_surface_subdiv" shape="ellipsoid" radii={[0.82,1.12,0.82]} segments="10" rings="6" material="s78_surface_mat">
      <Modifiers>
        <Subdivision levels="1" />
      </Modifiers>
      <MeshBuild quality="high" maxTriangles="1200" />
    </PrimitiveAsset>
    <PrimitiveAsset id="s78_surface_smooth" shape="ellipsoid" radii={[0.82,1.12,0.82]} segments="10" rings="6" material="s78_surface_mat">
      <Modifiers>
        <Subdivision levels="1" />
        <Smooth angle="180" />
      </Modifiers>
      <MeshBuild quality="high" maxTriangles="1200" />
    </PrimitiveAsset>
    <PrimitiveAsset id="s78_surface_weighted" shape="ellipsoid" radii={[0.82,1.12,0.82]} segments="10" rings="6" material="s78_surface_mat">
      <Modifiers>
        <Subdivision levels="1" />
        <Smooth angle="180" />
        <WeightedNormals strength="1" keepSharpEdges="false" />
      </Modifiers>
      <MeshBuild topology="triangles" triangulation="shortestDiagonal" quality="cinematic" maxTriangles="1200" />
      <LOD mode="auto" levels="4" preserveSilhouette="true" />
    </PrimitiveAsset>

    <!-- Row 3: legacy shapes beside their new parametric counterparts. -->
    <PrimitiveAsset id="s78_shape_box" shape="box" size={[1.25,1.6,1.25]} material="s78_shape_mat" />
    <PrimitiveAsset id="s78_shape_rounded" shape="roundedBox" size={[1.25,1.6,1.25]} radius="0.22" segments="5" material="s78_shape_mat">
      <Modifiers>
        <WeightedNormals strength="1" keepSharpEdges="true" />
      </Modifiers>
    </PrimitiveAsset>
    <PrimitiveAsset id="s78_shape_sphere" shape="sphere" radius="0.76" segments="20" rings="12" material="s78_shape_mat" />
    <PrimitiveAsset id="s78_shape_ellipsoid" shape="ellipsoid" radii={[0.6,1.02,0.76]} segments="20" rings="12" material="s78_shape_mat" />
    <PrimitiveAsset id="s78_shape_frustum_source" shape="box" size={[1.25,1.6,1.25]} material="s78_shape_mat" />
    <PrimitiveAsset id="s78_shape_frustum" shape="frustum" topSize={[0.58,0.58]} bottomSize={[1.25,1.25]} height="1.6" material="s78_shape_mat">
      <MeshBuild topology="quads" triangulation="shortestDiagonal" quality="high" maxTriangles="1000" />
    </PrimitiveAsset>

    <!-- Final build: the same features combined into one authored object. -->
    <PrimitiveAsset id="s78_hero_plinth" shape="roundedBox" size={[3.7,0.52,3.2]} radius="0.2" segments="6" material="s78_pedestal_mat">
      <Modifiers>
        <Taper axis="y" start="1.08" end="0.94" />
        <WeightedNormals strength="1" keepSharpEdges="true" />
      </Modifiers>
      <MeshBuild topology="quads" triangulation="shortestDiagonal" quality="cinematic" maxTriangles="16000" />
      <LOD mode="auto" levels="4" preserveSilhouette="true" />
    </PrimitiveAsset>
    <PrimitiveAsset id="s78_hero_core" shape="ellipsoid" radii={[0.72,1.35,0.56]} segments="28" rings="14" material="s78_hero_mat">
      <Modifiers>
        <Taper axis="y" start="1.08" end="0.74" />
        <Twist axis="y" angle="18" />
        <Bend axis="x" angle="-9" pivot={[0,0,0]} />
        <Subdivision levels="1" />
        <Smooth angle="180" />
        <WeightedNormals strength="0.9" keepSharpEdges="false" />
      </Modifiers>
      <MeshBuild topology="quads" triangulation="shortestDiagonal" quality="cinematic" maxTriangles="9000" />
      <LOD mode="auto" levels="4" preserveSilhouette="true" />
    </PrimitiveAsset>
    <PrimitiveAsset id="s78_hero_fin" shape="ellipsoid" radii={[0.16,1.0,0.08]} segments="20" rings="10" material="s78_hero_white">
      <Modifiers>
        <Taper axis="y" start="1.2" end="0.36" />
        <Bend axis="y" angle="28" pivot={[0,-0.46,0]} />
        <Twist axis="y" angle="-22" />
        <Smooth angle="180" />
      </Modifiers>
      <MeshBuild topology="quads" quality="high" maxTriangles="2400" />
    </PrimitiveAsset>
    <PrimitiveAsset id="s78_hero_light" shape="ellipsoid" radii={[0.12,0.38,0.12]} segments="18" rings="9" material="s78_glow">
      <Modifiers>
        <Twist axis="y" angle="24" />
        <Smooth angle="180" />
      </Modifiers>
      <MeshBuild quality="high" maxTriangles="800" />
    </PrimitiveAsset>
  </Assets>

