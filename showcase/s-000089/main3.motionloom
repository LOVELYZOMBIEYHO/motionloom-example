<!-- S89 / MIST COURTYARD / Existing RenderStyle study, no characters. -->
<Graph fps={30} duration="8s" size={[3840,2160]}>
  <!-- Grounded cinematic materials without ink contours or cel quantization. -->
  <RenderStyle id="courtyard_cinematic">
    <SurfaceStyle shading="filmic_physical_v1" specular="1" roughnessBias="0" />
    <OutlineStyle enabled="false" />
    <DepthOfFieldStyle preset="filmic_bokeh_v1" aperture="0.00032" maxBlur="0.0025" />
    <LightingStyle ambientIntensity="0" ambientColor="#FFFFFF" shadowStyle="soft" />
    <PostStyle toneMapping="filmic_aces_v1" exposure="0.97" saturation="1" contrast="1" whiteBalance="6500" bloomIntensity="0" />
  </RenderStyle>
  <Assets>
    <ImageAsset id="sky_asset" src="assets/sky.png" />
    <ModelAsset id="courtyard_asset" src="assets/courtyard-detail.glb" />
    <ModelAsset id="mountains_asset" src="assets/mountains-detail.glb" />
  </Assets>
  <Background color="#CBDCE4" />
  <Scene id="S89MistCourtyard" renderStyle="courtyard_cinematic">
    <Timeline>
      <Track id="world" space="3d">
        <Sequence from="0s" duration="8s" out="hold">
          <CompositeGroup id="s89_stage" space="3d" depth="true" format="rgba16f">
            <Camera3D id="s89_camera" position={[1.25,2.35,9]} target={[0,2.9,-13]} fov="57" depthOfField="true" focusDistance="16.2" />
            <EnvironmentLight id="sky" asset="sky_asset" intensity="0.1" visible="true" backgroundIntensity="0.65" diffuseIntensity="1" specularIntensity="1" />
            <DirectionalLight id="sun" direction={[-.9,-.65,-.3]} color="#FFE3BC" intensity="3.75" castShadow="true" shadowStrength="1" />
            <DirectionalLight id="sky_fill" direction={[.35,-.45,-.8]} color="#CBDDEB" intensity="0.45" />
            <PointLight id="lantern_fill" position={[-2.8,4.2,-1.9]} color="#FFD196" intensity="12" range="4" />
            <AmbientOcclusion radius="0.35" intensity="0" />
            <ContactShadow distance="0.2" softness="0.85" intensity="0" />
            <AtmosphereFog id="courtyard_mist" mode="linear" color="#C6D1D2" start="16" end="95" density="0.018" scattering="0.05" affectSky="false" />
            <Model id="courtyard" asset="courtyard_asset" scaleMode="none" scale="1" castShadow="true" receiveShadow="true" />
            <Model id="mountains" asset="mountains_asset" scaleMode="none" scale="1" />
          </CompositeGroup>
        </Sequence>
      </Track>
    </Timeline>
  </Scene>
  <!-- A slow push makes depth visible without distracting from the lighting study. -->
  <AnimationTarget node="s89_camera" property="position">
    <Key time="0s" value={[1.25,2.35,9]} />
    <Key time="8s" value={[.9,2.42,8]} ease="ease_in_out" />
  </AnimationTarget>
  <Present from="S89MistCourtyard" />
</Graph>
