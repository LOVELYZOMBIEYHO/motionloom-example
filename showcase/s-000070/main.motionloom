<!--
=====================================================================
S70 · CHARACTER 1 COMPLETE ACTION LIBRARY
54 s · 1920x1080 · 30 fps · one canonical GLB · all 43 embedded clips

PURPOSE
  Stress-test the canonical Character 1 action pipeline without importing a
  second character or hiding choreography inside one long baked clip.

  One character1.glb supplies the model, humanoid rig and 43 embedded clips.
  MotionLoom exposes all clips as executable Action nodes and schedules them
  with ApplyAction in the exact source order. Every numbered HUD entry maps
  one-to-one to one GLB clip: 01 starts the reel and 43 ends it.
=====================================================================
-->
<Graph fps={30} duration="54s" size={[1920,1080]} renderSize={[1920,1080]}>
  <Assets>
    <ModelAsset id="s70_character1_model"
                src="https://raw.githubusercontent.com/LOVELYZOMBIEYHO/motionloom-example/refs/heads/main/assets/sample_assets/characters/character1/character1.glb" />
