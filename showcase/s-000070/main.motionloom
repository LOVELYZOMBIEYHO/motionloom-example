          in={["s70_scene_tex"]} out={["s70_bloom_tex"]}
          params={{ threshold: "0.48", intensity: "0.34", sigma: "5.4" }} />
    <Pass id="s70_grain" kind="compute" effect="film_grain"
          in={["s70_bloom_tex"]} out={["s70_final_tex"]}
          params={{ kind: "film_grain", amount: "0.008", scale: "1.0", seed: "71" }} />
  </Process>

