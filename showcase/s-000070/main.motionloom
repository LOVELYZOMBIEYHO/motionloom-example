    <Key time="5.3s" value="0.38" ease="ease_in_out" />
    <Key time="8s" value="0.3" ease="ease_in" />
    <Key time="11.7s" value="0.56" ease="ease_out" />
    <Key time="14s" value="0.34" ease="ease_in" />
