<!-- S84 / CEL SHADING / native and browser comparison. -->
<Graph fps="30" duration="20s" size={[1980,1080]}>
  <Background color="#B9C6D4" />
  <RenderStyle id="cel_shaded">
    <SurfaceStyle shading="cel" shadingSteps="3" shadowColor="#75658F" specular="0.05" />
    <OutlineStyle enabled="true" color="#000000" width="2" method="geometry" distanceMode="screen" />
  </RenderStyle>
  <RenderStyle id="toon">
    <SurfaceStyle shading="toon" />
  </RenderStyle>
  <RenderStyle id="physical">
    <SurfaceStyle shading="physical" />
  </RenderStyle>
  <RenderStyle id="cel_no_outline">
    <SurfaceStyle shading="cel" shadingSteps="3" shadowColor="#75658F" specular="0.05" />
    <OutlineStyle enabled="false" />
  </RenderStyle>
  <Assets>
    <ImageAsset id="s84_cel_control" src="data:image/png;base64," colorSpace="linear-srgb" />
    <ModelAsset id="s84_character" src="../../assets/sample_assets/characters/character1/character1.glb" />
    <AnimationAsset id="s84_clips" src="../../assets/sample_assets/characters/character1/character1.glb" />
    <MaterialAsset id="teal" baseColor="#389B9F" roughness="0.65" />
    <MaterialAsset id="skin" baseColor="#F0BA97" roughness="0.8" />
    <MaterialAsset id="dark" baseColor="#333850" roughness="0.8" />
    <PrimitiveAsset id="ball" shape="sphere" radius="0.7" material="teal" />
    <PrimitiveAsset id="head" shape="sphere" radius="0.55" material="skin" />
    <PrimitiveAsset id="hair" shape="ellipsoid" radii={[0.56,0.25,0.525]} material="dark" />
    <PrimitiveAsset id="body" shape="box" size={[1,1.2,0.6]} bevelRadius="0.12" material="teal" />
    <PrimitiveAsset id="plinth" shape="box" size={[6,0.15,3]} material="dark" />
  </Assets>
  <ModelProfile id="s84_profile" kind="3d" model="s84_character" preset="humanoid_v1">
    <Retarget preset="humanoid_v1">
      <Map from="pelvis" to="hips" />
      <Map from="spine_01" to="spine" />
      <Map from="spine_02" to="chest" />
      <Map from="spine_03" to="upper_chest" />
      <Map from="neck_01" to="neck" />
      <Map from="Head" to="head" />
      <Map from="clavicle_l" to="shoulder_l" />
      <Map from="upperarm_l" to="upper_arm_l" />
      <Map from="lowerarm_l" to="forearm_l" />
      <Map from="hand_l" to="hand_l" />
      <Map from="clavicle_r" to="shoulder_r" />
      <Map from="upperarm_r" to="upper_arm_r" />
      <Map from="lowerarm_r" to="forearm_r" />
      <Map from="hand_r" to="hand_r" />
      <Map from="thigh_l" to="upper_leg_l" />
      <Map from="calf_l" to="lower_leg_l" />
      <Map from="foot_l" to="foot_l" />
      <Map from="ball_l" to="toe_l" />
      <Map from="thigh_r" to="upper_leg_r" />
      <Map from="calf_r" to="lower_leg_r" />
      <Map from="foot_r" to="foot_r" />
      <Map from="ball_r" to="toe_r" />
    </Retarget>
    <BoneAxisMap>
      <Axis bone="hips" turn="rotationY:1" />
      <Axis bone="spine" bend="rotationX:-1" turn="rotationY:1" />
      <Axis bone="chest" bend="rotationX:-1" turn="rotationY:1" />
      <Axis bone="upper_chest" bend="rotationX:-1" turn="rotationY:1" />
      <Axis bone="neck" bend="rotationX:-1" turn="rotationY:1" />
      <Axis bone="head" bend="rotationX:-1" turn="rotationY:1" />
      <Axis bone="upper_arm_l" forward="rotationX:1" side="rotationZ:1" twist="rotationY:1" restForward="-4.8" restSide="-89.8" />
      <Axis bone="forearm_l" bend="rotationX:1" twist="rotationY:1" />
      <Axis bone="upper_arm_r" forward="rotationX:1" side="rotationZ:-1" twist="rotationY:1" restForward="-4.8" restSide="-89.8" />
      <Axis bone="forearm_r" bend="rotationX:1" twist="rotationY:1" />
      <Axis bone="upper_leg_l" forward="rotationX:-1" side="rotationZ:-1" twist="rotationY:1" />
      <Axis bone="lower_leg_l" bend="rotationX:-1" twist="rotationY:1" />
      <Axis bone="upper_leg_r" forward="rotationX:-1" side="rotationZ:1" twist="rotationY:1" />
      <Axis bone="lower_leg_r" bend="rotationX:-1" twist="rotationY:1" />
    </BoneAxisMap>
  </ModelProfile>
  <Action id="s84_walk" source="s84_clips" sourceProfile="quaternius_humanoid" clip="Walk_Loop" skeleton="humanoid_v1" />
  <ApplyAction target="s84_actor" action="s84_walk" at="0s" duration="20s" loop="true" rootMotion="in_place" blendIn="0s" blendOut="0s" />
  <Scene id="cel_demo" renderStyle="physical">
    <Timeline>
      <Track space="3d">
        <Sequence from="0s" duration="20s">
          <CompositeGroup id="stage" space="3d" depth="true">
            <Camera3D id="cam" position={[0,2.8,8]} target={[0,0.8,0]} fov="42" />
            <DirectionalLight direction={[-0.4,-1,-0.5]} intensity="3" />
            <Model id="base" asset="plinth" position={[0,-0.12,0]} />
            <Model id="sphere" asset="ball" position={[-1.7,0.7,0]} />
            <Model id="s84_actor" asset="s84_character" profile="s84_profile" position={[0,0,0]} scaleMode="normalize_height" scale="2">
              <MaterialBinding material="*" outlineWidth="2" celShadowColor="#766A93" />
            </Model>
            <Model id="torso" asset="body" position={[1.7,0.6,0]} />
            <Model id="face" asset="head" position={[1.7,1.65,0]}>
              <MaterialBinding material="*" celRole="face" outlineWidth="1.5" celShadowColor="#B87E87" celControlMap="s84_cel_control" />
            </Model>
            <Model id="hair_model" asset="hair" position={[1.7,2.03,-0.10]}>
              <MaterialBinding material="*" celRole="hair" outlineWidth="2" hairHighlight="0.5" celControlMap="s84_cel_control" />
            </Model>
            <Model id="occluder" asset="ball" position={[4,0.7,1]} />
          </CompositeGroup>
        </Sequence>
      </Track>
      <Track space="screen">
        <Sequence from="0s" duration="20s">
          <Layer>
            <Text x="36" y="24" value="CEL SHADING / MOTIONLOOM" fontSize="24" color="#152035" />
            <Text x="36" y="492" value="SAME ASSETS / SAME LIGHT / CHARACTER1 CC0 / MATERIAL-SLOT OUTLINE CONTROL" fontSize="14" color="#152035" />
          </Layer>
        </Sequence>
        <Sequence from="0s" duration="3s">
          <Layer>
            <Text x="36" y="62" value="01 / PHYSICAL" fontSize="18" color="#152035" />
          </Layer>
        </Sequence>
        <Sequence from="3s" duration="3s">
          <Layer>
            <Text x="36" y="62" value="02 / TOON" fontSize="18" color="#152035" />
          </Layer>
        </Sequence>
        <Sequence from="6s" duration="3s">
          <Layer>
            <Text x="36" y="62" value="03 / CEL SHADING + BLACK OUTLINE" fontSize="18" color="#152035" />
          </Layer>
        </Sequence>
        <Sequence from="9s" duration="3s">
          <Layer>
            <Text x="36" y="62" value="04 / CEL SHADING - OUTLINE OFF" fontSize="18" color="#152035" />
          </Layer>
        </Sequence>
        <Sequence from="12s" duration="8s">
          <Layer>
            <Text x="36" y="62" value="05 / DISTANCE + OCCLUSION + SKINNING" fontSize="18" color="#152035" />
          </Layer>
        </Sequence>
      </Track>
    </Timeline>
  </Scene>
  <AnimationTarget node="cel_demo" property="renderStyle">
    <Key time="0s" value="physical" />
    <Key time="3s" value="toon" />
    <Key time="6s" value="cel_shaded" />
    <Key time="9s" value="cel_no_outline" />
    <Key time="12s" value="cel_shaded" />
  </AnimationTarget>
  <AnimationTarget node="cam" property="position">
    <Key time="0s" value={[0,2.8,8]} />
    <Key time="12s" value={[0,2.8,8]} />
    <Key time="15s" value={[3,2.4,6]} />
    <Key time="18s" value={[-2,3,10]} />
    <Key time="20s" value={[0,2.8,8]} />
  </AnimationTarget>
  <AnimationTarget node="occluder" property="position">
    <Key time="0s" value={[4,0.7,1]} />
    <Key time="12s" value={[4,0.7,1]} />
    <Key time="15s" value={[0,0.7,1.4]} />
    <Key time="18s" value={[-4,0.7,1]} />
    <Key time="20s" value={[-4,0.7,1]} />
  </AnimationTarget>
  <Present from="cel_demo" />
</Graph>
