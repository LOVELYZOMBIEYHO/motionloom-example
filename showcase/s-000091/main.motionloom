</ModelProfile>

  <!-- Great Sword Casting (Mixamo FBX converted offline by motionloom-action-tool). -->
  <ActionLibrary id="s91_lib_sword"
                 src="assets/actions/great_sword_casting.motionloom"
                 actions={["s91_sword_cast"]} />
  <ApplyAction target="s91_hero_a" action="s91_lib_sword.s91_sword_cast"
               at="3.5s" duration="14.5s" loop="true" rootMotion="clip"
               blendIn="0.3s" blendOut="0.3s" mask="full_body"
               ground="s91_boulder_top" floorSnap="0.25"
               safeMargin="0.01" sweepStep="0.03" />
  <Attachment id="s91_hero_sword_right_grip" object="s91_sword_a">
    <Socket id="main_grip" position={[0,-0.05,0]} rotation={[0,0,0]} />
    <Socket id="support_grip" position={[0,0.08,0]} rotation={[0,0,0]} />
    <Attach socket="main_grip" target="s91_hero_a.hand_r"
            mode="snap" drive="object"
            positionWeight="1" rotationWeight="1" />
    <Attach socket="support_grip" target="s91_hero_a.hand_l"
            mode="ik" drive="target"
            positionWeight="1" rotationWeight="0.8" maxStretch="1.05" />
  </Attachment>
  <Background color="#A6D4EE" />

  <Scene id="S91HanamachiCanalTown">
    <Defs>
      <LinearGradient id="s91_sky" x1="0" y1="0" x2="0" y2="1"
                      stops="0:#6FB6E8, 0.55:#A8D6F0, 1:#DCEFF8" />
      <RadialGradient id="s91_sun_glow" cx="0.5" cy="0.5" r="0.5"
                      stops="0:#FFF6DE, 0.4:#FFE9C066, 1:#FFE9C000" />
      <LinearGradient id="s91_haze" x1="0" y1="0" x2="0" y2="1"
                      stops="0:#FFFFFF00, 0.6:#FFFFFF33, 1:#FFFFFF00" />
      <RadialGradient id="s91_blush" cx="0.5" cy="0.5" r="0.5"
                      stops="0:#FF8FB4CC, 0.55:#FF8FB477, 1:#FF8FB400" />
      <RadialGradient id="s91_vignette" cx="0.5" cy="0.5" r="0.74"
                      stops="0:#00000000, 0.66:#00000014, 1:#00000078" />
    </Defs>

    <Timeline>
      <Track id="s91_sky_track" space="screen" compositeOrder="10">
        <Sequence from="0s" duration="18s" out="hold">
          <Layer space="screen">
            <Rect x="0" y="0" width="1280" height="720" fill="url(#s91_sky)" />
            <Circle x="1050" y="96" radius="240" fill="url(#s91_sun_glow)"
                    blend="screen" opacity="0.85" />
            <Rect x="0" y="300" width="1280" height="120" fill="url(#s91_haze)"
                  opacity="0.7" />
          </Layer>
        </Sequence>
      </Track>

      <Track id="s91_town_track" space="3d" compositeOrder="40">
        <Sequence from="0s" duration="18s" out="hold">
          <CompositeGroup id="s91_town" space="3d" depth="true" format="rgba16f">
            <DirectionalLight id="s91_sun" direction={[-0.55,-1,0.4]}
                              color="#FFF2D8" intensity="3.1"
                              castShadow="true" shadowStrength="0.62" />
            <DirectionalLight id="s91_sky_fill" direction={[0.5,-0.45,-0.5]}
                              color="#CDE2F2" intensity="0.85" />
            <AmbientOcclusion id="s91_ao" intensity="0.62" radius="0.5" />
            <ContactShadow id="s91_contact" intensity="0.82" distance="0.2"
                           softness="0.4" />
            <ColorManagement id="s91_grade" toneMapping="aces" exposure="1.02"
                             whiteBalance="6100" contrast="1.05" />
            <AtmosphereFog id="s91_haze3d" scatteringColor="#BBD8EA"
                           density="0.006" affectEnvironment="false" />

            <Camera3D id="s91_camera" position={[0.0,10.5,25.5]}
                      target={[0,2.0,0]} up={[0,1,0]}
                      horizonLock="true" fov="50" />
            <Camera3D id="s91_pair_cam" position={[0,2.9,18.5]}
                      target={[0,2.25,13.1]} up={[0,1,0]}
                      horizonLock="true" fov="50" />

            <!-- Ground plane and canal bed -->
            <Model id="s91_far_ground_m" asset="s91_far_ground" position={[0,-0.25,-4.4]} receiveShadow="true" />
            <Model id="s91_near_walk_m" asset="s91_near_walk" position={[0,-0.25,9.45]} receiveShadow="true" />
            <Model id="s91_near_ground_m" asset="s91_near_ground" position={[0,-0.25,13.1]} receiveShadow="true" />
            <Model id="s91_street_m" asset="s91_street" position={[0,0.03,1.6]} receiveShadow="true" />
            <!-- The invisible top collider and named ground keep Action contact
