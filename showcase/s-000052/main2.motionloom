                       transformOriginX="612" transformOriginY="456"
                       rotation={curve("0:0:linear, 6:7:ease_in_out")} scale="1" opacity="1">
                  <Circle id="iris_outer_dark_ring" x="612" y="456" radius="224"
                          color="#17112e" opacity="0.98" />
                  <Circle id="iris_color_disc" x="612" y="456" radius="211"
                          fill="url(#iris_cosmic)" />

                  <RadialRays id="iris_radial_fibers" x="612" y="456" count="84"
                              innerRadius="34" length="176" lengthVariation="0.28"
                              startAngle="-90" spread="360" stroke="#ffd7ff"
                              strokeWidth="2.2" rayOpacity="0.36" seed="52" />
                  <RadialRays id="iris_dark_fibers" x="612" y="456" count="46"
                              innerRadius="52" length="142" lengthVariation="0.42"
                              startAngle="-86" spread="360" stroke="#4b1a72"
                              strokeWidth="3" rayOpacity="4.34" seed="73" rotation="4" />

                  <Circle id="iris_inner_fire" x="612" y="456" radius="142"
                          fill="url(#iris_inner_fire)" opacity="0.86" blend="screen" />
                  <ParticleField id="iris_star_particles" x="612" y="456"
                                 width="350" height="350" count="150"
                                 minSize="1" maxSize="5" minOpacity="0.12" maxOpacity="0.94"
                                 color="#ffffff" seed="520" />
                  <ParticleField id="iris_pink_particles" x="612" y="456"
                                 width="380" height="370" count="96"
                                 minSize="1" maxSize="4" minOpacity="0.10" maxOpacity="0.74"
                                 color="#ff77dc" seed="812" />

                  <Rect id="vertical_prism_column" x="588" y="248" width="48" height="416"
                        radius="24" fill="url(#vertical_prism)" opacity="0.62" blend="screen" />
                  <Path id="left_prism_arc"
                        d="M 468 310 C 406 380 406 524 476 598 C 448 526 454 390 510 324 Z"
                        fill="#f1b4ff" opacity="0.34" blend="screen" />
                  <Path id="right_prism_arc"
                        d="M 756 310 C 818 380 818 524 748 598 C 776 526 770 390 714 324 Z"
                        fill="#ff80d4" opacity="0.32" blend="screen" />
                </Group>

                <Group id="left_central_starburst_group"
