                        fill="#ff61da" opacity="0.24" blend="screen" />
                 <Path id="central_eight_point_star"
      d="M 612 370 L 623 430 L 703 365 L 638 456 L 703 547 L 623 482 L 612 542 L 601 482 L 521 547 L 586 456 L 521 365 L 601 430 Z"
      fill="#ffffff" opacity="0.92" blend="screen" />
                  <Path id="central_vertical_ray"
