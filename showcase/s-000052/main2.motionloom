<Graph fps={30} duration="6s" size={[1200,900]} renderSize={[1200,900]}>
  <Background color="#D5A99E" />

  <Scene id="cosmic_prism_eye">
    <Defs>
      <RadialGradient id="sclera_pearl" cx="0.48" cy="0.42" r="0.72"
                      stops="0:#ffffff, 0.52:#fff7fc, 0.82:#f3dcea, 1:#c995ad" />
      <RadialGradient id="iris_cosmic" cx="0.50" cy="0.54" r="0.58"
                      stops="0:#fff9ff, 0.10:#fff0ff, 0.24:#ffb8f3, 0.46:#ef49cb, 0.68:#a63bbd, 0.84:#472478, 1:#171333" />
      <RadialGradient id="iris_inner_fire" cx="0.50" cy="0.50" r="0.58"
                      stops="0:#ffffff, 0.10:#fff9d6, 0.26:#ff96e8, 0.56:#d91ab2, 0.82:#471d85, 1:#08091e00" />
      <LinearGradient id="vertical_prism" x1="0" y1="0" x2="0" y2="1"
                      stops="0:#8ad9ff00, 0.20:#c09cff99, 0.48:#ffffffee, 0.72:#ff58ca99, 1:#ff51bd00" />
      <LinearGradient id="upper_lid" x1="0" y1="0" x2="0" y2="1"
                      stops="0:#5b203f, 0.35:#9d4169, 0.72:#4a1738, 1:#160d22" />

      <Noise id="iris_polar_noise" type="polar" scale="22" octaves="5" seed="52"
             contrast="1.45" evolution={curve("0:0:linear, 6:2.4:linear")} />
      <Noise id="glass_warp_noise" type="flow" scale="10" octaves="4" seed="19"
             contrast="1.18" evolution={curve("0:0:linear, 6:1.2:ease_in_out")} />
      <Noise id="skin_low_frequency" type="fbm" scale="4" octaves="4" seed="27"
             contrast="1.10" evolution="0" />
      <Noise id="skin_pores" type="cellular" scale="85" octaves="3" seed="93"
             contrast="0.92" evolution="0" />
      <Material id="cosmic_iris_material"
                texture="iris_polar_noise" textureAmount="0.28"
                displacement="iris_polar_noise" displacementAmount="3.5"
                roughness="0.18" specular="0.82"
                refraction="5.5" dispersion="2.1" glass="0.82" opacity="1" />
      <Material id="cornea_glass_material"
                texture="glass_warp_noise" textureAmount="0.10"
                displacement="glass_warp_noise" displacementAmount="2"
                roughness="0.10" specular="0.92"
                refraction="3.2" dispersion="1.2" glass="0.72" opacity="1" />
      <Material id="skin_material"
                texture="skin_pores" textureAmount="0.06"
                displacement="skin_low_frequency" displacementAmount="1.2"
                roughness="0.72" specular="0.12" opacity="1" />

      <Filter id="cosmic_optical_finish">
        <LightStreak radius="34" amount="0.72" scale="-90" seed="0.64" />
        <ChromaticAberration radius="2.6" amount="0.72" />
        <HighlightCompression scale="0.78" amount="0.74" />
      </Filter>
      <Filter id="soft_iris_bloom">
        <Blur radius="7" />
      </Filter>
      <Filter id="soft_eye_edge">
        <EdgeSoftness radius="2" amount="0.44" preserveInterior="0.94" />
        <ColorBleed radius="2" amount="0.08" />
      </Filter>
      <Filter id="skin_shadow_blur">
        <Blur radius="18" />
      </Filter>
      <Filter id="eye_socket_blur">
        <Blur radius="24" />
      </Filter>
      <Filter id="eyebrow_treatment">
        <EdgeSoftness radius="1.4" amount="0.32" preserveInterior="0.90" />
        <EdgeRoughness radius="0.8" amount="0.34" scale="18" seed="52" />
      </Filter>
      <Filter id="eye_frame_passthrough">
        <HighlightCompression scale="0.999" amount="0" />
      </Filter>
      <Filter id="star_layer_passthrough">
        <HighlightCompression scale="0.999" amount="0" />
      </Filter>

      <Precompose id="cosmic_eye_aperture" size={[1200,900]}>
        <Path id="cosmic_eye_aperture_path"
              d="M 245 462 C 255 300 405 200 600 200 C 780 200 925 300 940 455 C 930 610 790 700 580 700 C 380 700 255 610 245 462 Z"
              fill="#ffffff" />
      </Precompose>
      <Component id="left_cosmic_eye_component">
            <Group id="left_cosmic_eye_all_group" effects={["soft_eye_edge"]}
                   transformOriginX="610" transformOriginY="455" scale="1">
              <Group id="left_skin_surface_group" material="skin_material">

              </Group>

              <Group id="left_upper_skin_shadow" effects={["skin_shadow_blur"]} scale="1">
                <Path d="M 84 382 C 250 104 526 70 754 126 C 938 170 1082 294 1148 398 C 922 254 718 210 518 242 C 340 270 204 342 84 382 Z"
                      fill="#8a3e62" opacity="0.14" />
              </Group>

              <Group id="left_eye_socket_modeling_group" effects={["eye_socket_blur"]} scale="1">
                <Path id="upper_eye_socket_shadow"
                      d="M 122 420 C 254 190 474 136 684 160 C 866 180 1012 290 1090 406 C 938 316 790 278 620 286 C 430 294 278 344 122 420 Z"
                      fill="#9b4d70" opacity="0.13" />
                <Path id="under_eye_violet_shadow"
                      d="M 184 528 C 348 684 762 752 1058 496 C 926 700 716 788 484 744 C 334 716 228 632 184 528 Z"
                      fill="#694b78" opacity="0.12" />
                <Path id="outer_corner_warmth"
                      d="M 918 420 C 1000 400 1080 430 1134 492 C 1062 474 1002 482 944 520 Z"
                      fill="#bd5878" opacity="0.12" />
              </Group>

              <Group id="left_eye_contents_group" maskFrom="cosmic_eye_aperture" maskMode="alpha"
                     maskExpansion="-1" maskFeather="2.4">
                <Path id="sclera_shape"
                      d="M 245 462 C 255 300 405 200 600 200 C 780 200 925 300 940 455 C 930 610 790 700 580 700 C 380 700 255 610 245 462 Z"
                      fill="url(#sclera_pearl)" />

                <Group id="left_iris_outer_glow_group" x="-50" effects={["soft_iris_bloom"]} scale="1">
                  <Circle x="612" y="456" radius="252" color="#bd49e8" opacity="0.30" blend="screen" />
                  <Circle x="612" y="456" radius="214" color="#ff42ca" opacity="0.30" blend="color-dodge" />
                </Group>

                <Group id="left_iris_glass_group" material="cosmic_iris_material"
