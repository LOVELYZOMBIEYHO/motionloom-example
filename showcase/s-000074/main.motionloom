    <ModelAsset id="s74_character_model" src="https://raw.githubusercontent.com/LOVELYZOMBIEYHO/motionloom-example/refs/heads/main/assets/sample_assets/characters/character1/character1.glb" />
    <AnimationAsset id="s74_character_clips" src="https://raw.githubusercontent.com/LOVELYZOMBIEYHO/motionloom-example/refs/heads/main/assets/sample_assets/characters/character1/character1.glb" />
  </Assets>

  <Action id="s74_walk" source="s74_character_clips" sourceProfile="quaternius_humanoid"
          clip="Walk_Loop" skeleton="humanoid_v1" />
  <ModelProfile id="s74_character_profile" kind="3d" model="s74_character_model" preset="humanoid_v1">
    <Retarget preset="humanoid_v1">
      <Map from="pelvis" to="hips" /><Map from="spine_01" to="spine" />
      <Map from="spine_03" to="chest" /><Map from="neck_01" to="neck" />
      <Map from="Head" to="head" /><Map from="clavicle_l" to="shoulder_l" />
      <Map from="upperarm_l" to="upper_arm_l" /><Map from="lowerarm_l" to="forearm_l" />
      <Map from="hand_l" to="hand_l" /><Map from="clavicle_r" to="shoulder_r" />
      <Map from="upperarm_r" to="upper_arm_r" /><Map from="lowerarm_r" to="forearm_r" />
      <Map from="hand_r" to="hand_r" /><Map from="thigh_l" to="upper_leg_l" />
      <Map from="calf_l" to="lower_leg_l" /><Map from="foot_l" to="foot_l" />
      <Map from="ball_l" to="toe_l" /><Map from="thigh_r" to="upper_leg_r" />
      <Map from="calf_r" to="lower_leg_r" /><Map from="foot_r" to="foot_r" />
      <Map from="ball_r" to="toe_r" />
    </Retarget>
    <BoneAxisMap>
      <Axis bone="hips" turn="rotationY:1" />
      <Axis bone="spine" bend="rotationX:-1" turn="rotationY:1" />
      <Axis bone="chest" bend="rotationX:-1" turn="rotationY:1" />
      <Axis bone="neck" bend="rotationX:-1" turn="rotationY:1" />
      <Axis bone="head" bend="rotationX:-1" turn="rotationY:1" />
      <Axis bone="upper_arm_l" forward="rotationX:1" side="rotationZ:1" twist="rotationY:1" restForward="-4.8" restSide="-89.8" />
      <Axis bone="forearm_l" bend="rotationX:1" twist="rotationY:1" />
      <Axis bone="upper_arm_r" forward="rotationX:1" side="rotationZ:-1" twist="rotationY:1" restForward="-4.8" restSide="-89.8" />
      <Axis bone="forearm_r" bend="rotationX:1" twist="rotationY:1" />
      <Axis bone="upper_leg_l" forward="rotationX:-1" side="rotationZ:-1" twist="rotationY:1" />
      <Axis bone="lower_leg_l" bend="rotationX:-1" twist="rotationY:1" />
      <Axis bone="upper_leg_r" forward="rotationX:-1" side="rotationZ:1" twist="rotationY:1" />
      <Axis bone="lower_leg_r" bend="rotationX:-1" twist="rotationY:1" />
    </BoneAxisMap>
  </ModelProfile>
  <ApplyAction target="s74_walker" action="s74_walk" at="0s" duration="9s"
               loop="true" rootMotion="in_place" blendIn="0s" blendOut="0.15s"
               mask="full_body" footLock="auto" />

