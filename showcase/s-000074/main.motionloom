            <PointLight id="s74_concourse_fill" position={[0,2.6,3.4]}
                        color="#B9D8EA" intensity="7" range="9" />
            <PointLight id="s74_poster_wash_left" position={[-4.4,4.5,-2.7]}
                        color="#62D9EE" intensity="4.2" range="4.5" />
            <PointLight id="s74_poster_wash_right" position={[4.4,4.5,-2.7]}
                        color="#E890C5" intensity="3.8" range="4.5" />
            <PointLight id="s74_street_lamp_left" position={[-6.2,7.25,-8.4]}
