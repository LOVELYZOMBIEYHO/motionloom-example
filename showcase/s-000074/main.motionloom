      <Instance id="leaf_left_tip" asset="s74_tree_leaf_mid" position={[-1.48,4.38,0.10]} rotation={[-12,24,22]} scale="0.82" />
      <Instance id="leaf_right_01" asset="s74_tree_leaf_deep" position={[0.96,3.78,-0.16]} rotation={[-10,29,19]} scale="1.00" />
      <Instance id="leaf_right_02" asset="s74_tree_leaf_mid" position={[1.22,4.16,0.12]} rotation={[8,-41,-14]} scale="1.04" />
      <Instance id="leaf_right_03" asset="s74_tree_leaf_sun" position={[0.98,4.58,-0.18]} rotation={[-15,21,13]} scale="1.02" />
