            <PointLight id="s74_street_lamp_right" position={[6.4,7.25,-12.6]}
                        color="#FFD08A" intensity="10" range="8" />
            <SpotLight id="s74_car_sweep_left" position={[-10,4.1,-12.0]}
                       direction={[0,-0.38,0.35]} color="#D7F1FF"
                       intensity={curve("0:0:linear, 5.9:0:linear, 6.45:16:linear, 7.05:0:linear, 9:0:linear")}
                       range="18" innerCone="10" outerCone="28" />
            <SpotLight id="s74_car_sweep_mid" position={[0,4.1,-12.0]}
                       direction={[0,-0.38,0.35]} color="#D7F1FF"
