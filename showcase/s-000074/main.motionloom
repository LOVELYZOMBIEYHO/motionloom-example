            <Model id="s74_floor_joint_x04" asset="s74_floor_joint_x" position={[0,0.012,-9.0]} />
            <Model id="s74_floor_joint_z01" asset="s74_floor_joint_z" position={[-8.0,0.013,-0.7]} />
            <Model id="s74_floor_joint_z02" asset="s74_floor_joint_z" position={[0,0.013,-0.7]} />
            <Model id="s74_floor_joint_z03" asset="s74_floor_joint_z" position={[8.0,0.013,-0.7]} />
            <Model id="s74_glass_clamp_l_top" asset="s74_glass_clamp" position={[-7.82,4.45,-11.01]} />
            <Model id="s74_glass_clamp_l_bottom" asset="s74_glass_clamp" position={[-7.82,1.05,-11.01]} />
            <Model id="s74_glass_clamp_c_top" asset="s74_glass_clamp" position={[-0.48,4.45,-11.01]} />
            <Model id="s74_glass_clamp_c_bottom" asset="s74_glass_clamp" position={[-0.48,1.05,-11.01]} />
            <Model id="s74_glass_clamp_r_top" asset="s74_glass_clamp" position={[7.82,4.45,-11.01]} />
            <Model id="s74_glass_clamp_r_bottom" asset="s74_glass_clamp" position={[7.82,1.05,-11.01]} />

            <!-- Eleven collider-owning primitives form one reusable typed asset. -->
            <Model id="s74_staircase_model" asset="s74_staircase"
                   castShadow="true" receiveShadow="true" />

            <!-- Wedges close the stair silhouette without encoding geometry in src. -->
            <Model id="s74_left_stringer" asset="s74_stringer"
                   position={[-2.03,1.76,0.05]} rotationY="180"
                   castShadow="true" receiveShadow="true" />
            <Model id="s74_right_stringer" asset="s74_stringer"
                   position={[2.03,1.76,0.05]} rotationY="180"
                   castShadow="true" receiveShadow="true" />

            <Model id="s74_landing_model" asset="s74_landing"
                   position={[0,3.54,-6.95]}
                   castShadow="true" receiveShadow="true" />
            <Model id="s74_landing_inlay_model" asset="s74_landing_inlay"
                   position={[0,3.725,-6.95]} receiveShadow="true" />

            <!-- Shared cylinders form paired rail posts on both sides. -->
            <Model id="s74_post_l01" asset="s74_post" position={[-2.30,0.96,3.80]} />
            <Model id="s74_post_r01" asset="s74_post" position={[2.30,0.96,3.80]} />
