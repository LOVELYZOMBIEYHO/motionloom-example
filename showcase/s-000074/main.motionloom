      <Instance id="leaf_front_01" asset="s74_tree_leaf_deep" position={[-0.44,3.72,0.76]} rotation={[-18,17,8]} scale="1.06" />
      <Instance id="leaf_front_02" asset="s74_tree_leaf_mid" position={[0.38,4.08,0.90]} rotation={[13,-26,-16]} scale="1.00" />
      <Instance id="leaf_front_03" asset="s74_tree_leaf_sun" position={[-0.22,4.57,0.86]} rotation={[-11,36,18]} scale="0.92" />
      <Instance id="leaf_front_tip" asset="s74_tree_leaf_mid" position={[0.18,4.18,1.20]} rotation={[16,-19,12]} scale="0.76" />
      <Instance id="leaf_back_01" asset="s74_tree_leaf_deep" position={[0.42,3.78,-0.78]} rotation={[14,23,-10]} scale="1.04" />
      <Instance id="leaf_back_02" asset="s74_tree_leaf_mid" position={[-0.39,4.14,-0.93]} rotation={[-16,-32,15]} scale="0.98" />
      <Instance id="leaf_back_03" asset="s74_tree_leaf_sun" position={[0.20,4.62,-0.82]} rotation={[10,39,-17]} scale="0.90" />
      <Instance id="leaf_back_tip" asset="s74_tree_leaf_deep" position={[-0.12,4.24,-1.18]} rotation={[-13,-22,20]} scale="0.74" />

      <Instance id="leaf_top_left" asset="s74_tree_leaf_sun" position={[-0.48,4.96,0.08]} rotation={[-9,-37,-13]} scale="1.04" />
      <Instance id="leaf_top_center" asset="s74_tree_leaf_sun" position={[0.12,5.16,-0.06]} rotation={[12,18,9]} scale="1.12" />
      <Instance id="leaf_top_right" asset="s74_tree_leaf_mid" position={[0.68,4.94,0.12]} rotation={[-14,31,16]} scale="0.94" />
      <Instance id="leaf_drop_left" asset="s74_tree_leaf_deep" position={[-1.14,3.42,-0.08]} rotation={[17,-25,-18]} scale="0.78" />
      <Instance id="leaf_drop_right" asset="s74_tree_leaf_deep" position={[1.08,3.48,0.18]} rotation={[-12,34,14]} scale="0.82" />
    </CompoundAsset>
    <!-- Shrubs share the tree foliage atlas; layout, tint and seed prevent clones. -->
    <CompoundAsset id="s74_courtyard_shrub" materialSeed="7670">
      <Instance id="shrub_core" asset="s74_tree_leaf_deep" position={[0,0.48,0]} rotation={[4,12,-3]} scale="0.82" />
      <Instance id="shrub_left" asset="s74_tree_leaf_mid" position={[-0.43,0.42,0.06]} rotation={[-8,-31,17]} scale="0.64" />
      <Instance id="shrub_right" asset="s74_tree_leaf_mid" position={[0.43,0.46,-0.08]} rotation={[10,37,-14]} scale="0.68" />
      <Instance id="shrub_front" asset="s74_tree_leaf_sun" position={[0.04,0.36,0.40]} rotation={[-15,18,11]} scale="0.58" />
      <Instance id="shrub_back" asset="s74_tree_leaf_deep" position={[-0.08,0.39,-0.39]} rotation={[12,-24,-9]} scale="0.60" />
      <Instance id="shrub_top" asset="s74_tree_leaf_sun" position={[0.08,0.83,0.02]} rotation={[-7,43,8]} scale="0.56" />
    </CompoundAsset>
    <ModelAsset id="s74_character1_model"
                src="https://raw.githubusercontent.com/LOVELYZOMBIEYHO/motionloom-example/refs/heads/main/assets/sample_assets/characters/character1/character1.glb" />
    <AnimationAsset id="s74_character1_clips"
                    src="https://raw.githubusercontent.com/LOVELYZOMBIEYHO/motionloom-example/refs/heads/main/assets/sample_assets/characters/character1/character1.glb" />
    <ImageAsset id="s74_courtyard_hdri"
                src="https://raw.githubusercontent.com/LOVELYZOMBIEYHO/motionloom-example/refs/heads/main/showcase/s-000073/assets/cinematic_courtyard.hdr" />
  </Assets>

  <Action id="s74_walk_upstairs"
          source="s74_character1_clips"
          sourceProfile="quaternius_humanoid"
          clip="Walk_Loop"
          skeleton="humanoid_v1" />

  <ModelProfile id="s74_character1_profile" kind="3d"
                model="s74_character1_model" preset="humanoid_v1">
    <Retarget preset="humanoid_v1">
      <Map from="pelvis" to="hips" />
      <Map from="spine_01" to="spine" />
      <Map from="spine_03" to="chest" />
      <Map from="neck_01" to="neck" />
      <Map from="Head" to="head" />
      <Map from="clavicle_l" to="shoulder_l" />
      <Map from="upperarm_l" to="upper_arm_l" />
      <Map from="lowerarm_l" to="forearm_l" />
      <Map from="hand_l" to="hand_l" />
      <Map from="clavicle_r" to="shoulder_r" />
      <Map from="upperarm_r" to="upper_arm_r" />
      <Map from="lowerarm_r" to="forearm_r" />
      <Map from="hand_r" to="hand_r" />
      <Map from="thigh_l" to="upper_leg_l" />
      <Map from="calf_l" to="lower_leg_l" />
      <Map from="foot_l" to="foot_l" />
      <Map from="ball_l" to="toe_l" />
      <Map from="thigh_r" to="upper_leg_r" />
      <Map from="calf_r" to="lower_leg_r" />
      <Map from="foot_r" to="foot_r" />
      <Map from="ball_r" to="toe_r" />
    </Retarget>
    <BoneAxisMap>
      <Axis bone="hips" turn="rotationY:1" />
      <Axis bone="spine" bend="rotationX:-1" turn="rotationY:1" />
      <Axis bone="chest" bend="rotationX:-1" turn="rotationY:1" />
      <Axis bone="neck" bend="rotationX:-1" turn="rotationY:1" />
      <Axis bone="head" bend="rotationX:-1" turn="rotationY:1" />
      <Axis bone="upper_arm_l" forward="rotationX:1" side="rotationZ:1"
            twist="rotationY:1" restForward="-4.8" restSide="-89.8" />
      <Axis bone="forearm_l" bend="rotationX:1" twist="rotationY:1" />
      <Axis bone="upper_arm_r" forward="rotationX:1" side="rotationZ:-1"
            twist="rotationY:1" restForward="-4.8" restSide="-89.8" />
      <Axis bone="forearm_r" bend="rotationX:1" twist="rotationY:1" />
      <Axis bone="upper_leg_l" forward="rotationX:-1" side="rotationZ:-1"
            twist="rotationY:1" />
      <Axis bone="lower_leg_l" bend="rotationX:-1" twist="rotationY:1" />
      <Axis bone="upper_leg_r" forward="rotationX:-1" side="rotationZ:1"
            twist="rotationY:1" />
      <Axis bone="lower_leg_r" bend="rotationX:-1" twist="rotationY:1" />
    </BoneAxisMap>
  </ModelProfile>

  <ApplyAction target="s74_walker" action="s74_walk_upstairs"
               at="0s" duration="8s" loop="true"
               rootMotion="in_place" blendIn="0s" blendOut="0.15s"
               mask="full_body" footLock="auto" />

  <Background color="#07111F" />

  <Scene id="S74MultiCameraStairAscent">
    <Timeline>
      <Track id="s74_architecture" space="3d" compositeOrder="30">
        <Sequence from="0s" duration="8s" out="hold">
          <CompositeGroup id="s74_stair_island" space="3d" depth="true"
                          format="rgba16f">
            <EnvironmentLight id="s74_ibl"
                              asset="s74_courtyard_hdri"
                              mapping="equirectangular"
                              rotationY="-35"
                              intensity="0.74"
                              visible="true"
                              backgroundIntensity="0.42"
                              backgroundBlur="0.14"
                              diffuseIntensity="0.6"
                              specularIntensity="0.92" />
            <DirectionalLight id="s74_sunset_key"
                              direction={[-0.62,-1,-0.34]}
                              color="#FFE0BD" intensity="3.35"
                              castShadow="true" shadowStrength="0.88" />
            <PointLight id="s74_landing_light"
                        position={[0,5.0,-5.1]}
                        color="#FFD79A" intensity="11" range="11" />
            <SpotLight id="s74_character_rim"
                       position={[-4.8,5.8,-1.4]}
                       direction={[0.62,-0.58,0.35]}
                       color="#8FC8DA" intensity="11" range="13"
                       innerCone="17" outerCone="36" />
            <RectAreaLight id="s74_fill"
                           position={[4.5,5.8,3.8]}
                           direction={[-0.55,-0.7,-0.45]}
                           color="#BCD7E2" intensity="3.0"
                           width="4.5" height="3" />
            <AmbientOcclusion id="s74_ao" intensity="0.72" radius="0.48" />
            <ContactShadow id="s74_contact"
                           intensity="0.9" distance="0.16" softness="0.5" />
            <ColorManagement id="s74_grade"
                             toneMapping="aces" exposure="0.86"
                             whiteBalance="6100" contrast="1.04" />

            <Camera3D id="s74_fp_camera"
                      position="@s74_eye_anchor"
                      target="@s74_fp_look_anchor"
                      hiddenBones={["s74_walker:head"]}
                      up={[0,1,0]} horizonLock="true" fov="62" />
            <Camera3D id="s74_third_camera"
                      position="@s74_third_position"
                      target="@s74_head_anchor"
                      up={[0,1,0]} horizonLock="true" fov="38" />
            <Camera3D id="s74_close_camera"
                      position={[-1.35,5.65,-8.0]}
                      target="@s74_close_target"
                      up={[0,1,0]} horizonLock="true" fov="32" />
            <!-- Restored from the original S74 main: frame 180 reveals the full courtyard. -->
            <Camera3D id="s74_overview_camera"
                      position={[12.8,5.75,14.6]}
                      target={[0,2.05,-1.65]}
                      up={[0,1,0]} horizonLock="true" fov="35" />

            <Model id="s74_ground_model" asset="s74_ground"
                   position={[0,-0.15,-0.7]}
                   receiveShadow="true" exposure="0.9" />

            <!-- Simplified courtyard geometry gives the HDR environment scale,
                 parallax and surfaces that can receive architectural shadows. -->
            <Model id="s74_back_wall" asset="s74_wall_wide"
                   position={[0,3.1,-11.4]} castShadow="true" receiveShadow="true" />
            <Model id="s74_left_wall" asset="s74_wall_side"
                   position={[-14.0,2.45,-4.0]} castShadow="true" receiveShadow="true" />
            <Model id="s74_right_wall" asset="s74_wall_side"
                   position={[16.0,2.45,-4.0]} castShadow="true" receiveShadow="true" />
            <Model id="s74_glass_left" asset="s74_glass_panel"
                   position={[-4.15,2.75,-11.18]} receiveShadow="true" />
            <Model id="s74_glass_right" asset="s74_glass_panel"
                   position={[4.15,2.75,-11.18]} receiveShadow="true" />
            <Model id="s74_mullion_far_left" asset="s74_window_mullion" position={[-7.9,2.75,-11.08]} />
            <Model id="s74_mullion_left" asset="s74_window_mullion" position={[-4.15,2.75,-11.08]} />
            <Model id="s74_mullion_center_l" asset="s74_window_mullion" position={[-0.38,2.75,-11.08]} />
            <Model id="s74_mullion_center_r" asset="s74_window_mullion" position={[0.38,2.75,-11.08]} />
            <Model id="s74_mullion_right" asset="s74_window_mullion" position={[4.15,2.75,-11.08]} />
            <Model id="s74_mullion_far_right" asset="s74_window_mullion" position={[7.9,2.75,-11.08]} />
            <Model id="s74_window_header_left" asset="s74_window_header" position={[-4.15,4.98,-11.08]} />
            <Model id="s74_window_header_right" asset="s74_window_header" position={[4.15,4.98,-11.08]} />
            <Model id="s74_planter_left" asset="s74_planter"
                   position={[-6.8,0.375,-7.0]} castShadow="true" receiveShadow="true" />
            <Model id="s74_planter_right" asset="s74_planter"
                   position={[6.8,0.375,-7.0]} castShadow="true" receiveShadow="true" />
            <Model id="s74_shrub_left_a" asset="s74_courtyard_shrub" position={[-7.45,0.76,-7.0]} rotationY="-18" />
            <Model id="s74_shrub_left_b" asset="s74_courtyard_shrub" position={[-6.25,0.73,-6.95]} rotationY="71" scale="0.86" />
            <Model id="s74_shrub_right_a" asset="s74_courtyard_shrub" position={[7.45,0.76,-7.0]} rotationY="139" />
            <Model id="s74_shrub_right_b" asset="s74_courtyard_shrub" position={[6.25,0.73,-6.95]} rotationY="-63" scale="0.86" />
            <Model id="s74_tree_left" asset="s74_courtyard_tree"
                   position={[-8.2,0,-8.8]} rotationY="-18"
                   castShadow="true" receiveShadow="true" />
            <Model id="s74_tree_right" asset="s74_courtyard_tree"
                   position={[8.2,0,-8.8]} rotationY="137" scale="0.94"
                   castShadow="true" receiveShadow="true" />

            <!-- Weathering, drainage, paving seams and fasteners are non-colliding. -->
            <Model id="s74_back_wall_plinth" asset="s74_wall_plinth" position={[0,0.26,-11.18]} />
            <Model id="s74_left_wall_plinth" asset="s74_wall_side_plinth" position={[-13.78,0.26,-4.0]} />
            <Model id="s74_right_wall_plinth" asset="s74_wall_side_plinth" position={[15.78,0.26,-4.0]} />
            <Model id="s74_drain_left" asset="s74_drain_channel" position={[-3.7,0.018,-0.7]} />
            <Model id="s74_drain_right" asset="s74_drain_channel" position={[3.7,0.018,-0.7]} />
            <Model id="s74_floor_joint_x01" asset="s74_floor_joint_x" position={[0,0.012,7.2]} />
            <Model id="s74_floor_joint_x02" asset="s74_floor_joint_x" position={[0,0.012,1.2]} />
