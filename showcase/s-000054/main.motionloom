<Graph fps={30} duration="6s" size={[1280,900]} renderSize={[1280,900]}>
  <Background color="#F2EEE7" />

  <Skeleton id="hero_rig"
            profile="anime_6_head"
            height="720"
            facing="front"
            symmetryAxis="body_center"
            validation="strict"
            autoCorrect="proportions"
            overlay="true">
    <!-- Semantic bones are the animation and retargeting source of truth. -->
    <Bone id="root" role="root" x="0" y="0" />
    <Bone id="pelvis" role="pelvis" parent="root" x="0" y="-220" />
    <Bone id="spine" role="spine" parent="pelvis" x="0" y="-82" />
    <Bone id="chest" role="chest" parent="spine" x="0" y="-82" />
    <Bone id="neck" role="neck" parent="chest" x="0" y="-70" />
    <Bone id="head" role="head" parent="neck" x="0" y="-86" />

    <Bone id="left_upper_arm" role="upper_arm" side="left" parent="chest" x="-102" y="-10" />
    <Bone id="left_forearm" role="forearm" side="left" parent="left_upper_arm" x="-108" y="70" />
    <Bone id="left_hand" role="hand" side="left" parent="left_forearm" x="-76" y="78" />
    <Bone id="right_upper_arm" role="upper_arm" side="right" parent="chest" x="102" y="-10" />
    <Bone id="right_forearm" role="forearm" side="right" parent="right_upper_arm" x="108" y="70" />
    <Bone id="right_hand" role="hand" side="right" parent="right_forearm" x="76" y="78" />

    <Bone id="left_thigh" role="thigh" side="left" parent="pelvis" x="-42" y="24" />
    <Bone id="left_shin" role="shin" side="left" parent="left_thigh" x="0" y="150" />
    <Bone id="left_foot" role="foot" side="left" parent="left_shin" x="0" y="148" />
    <Bone id="right_thigh" role="thigh" side="right" parent="pelvis" x="42" y="24" />
    <Bone id="right_shin" role="shin" side="right" parent="right_thigh" x="0" y="150" />
    <Bone id="right_foot" role="foot" side="right" parent="right_shin" x="0" y="148" />

    <!-- Landmarks separate anatomy from the artwork attached to each bone. -->
    <Landmark id="body_center" bone="root" offset={[0,0]} />
    <Landmark id="face_center" bone="head" offset={[0,0]} />
    <Landmark id="eye_line" bone="head" offset={[0,-12]} />
    <Landmark id="left_eye" bone="head" offset={[-28,-12]} />
    <Landmark id="right_eye" bone="head" offset={[28,-12]} />
    <Landmark id="nose_tip" bone="head" offset={[0,12]} />
    <Landmark id="mouth_center" bone="head" offset={[0,36]} />
    <Landmark id="head_top" bone="head" offset={[0,-72]} />
    <Landmark id="chin" bone="head" offset={[0,76]} />
    <Landmark id="left_shoulder" bone="left_upper_arm" offset={[0,0]} />
    <Landmark id="right_shoulder" bone="right_upper_arm" offset={[0,0]} />
    <Landmark id="chest_top" bone="chest" offset={[0,-34]} />
    <Landmark id="waist" bone="pelvis" offset={[0,-26]} />
    <Landmark id="left_hip" bone="left_thigh" offset={[0,0]} />
    <Landmark id="left_ankle" bone="left_foot" offset={[0,0]} />

    <!-- Measures and ratios make the intended body design machine-checkable. -->
    <Measure id="head_height" from="head_top" to="chin" />
    <Measure id="shoulder_width" from="left_shoulder" to="right_shoulder" />
    <Measure id="leg_length" from="left_hip" to="left_ankle" />
    <Ratio measure="head_height" relativeTo="body_height" value="0.1667" tolerance="0.02" />
    <Ratio measure="shoulder_width" relativeTo="head_width" value="1.85" tolerance="0.08" />
    <Ratio measure="leg_length" relativeTo="body_height" value="0.49" tolerance="0.04" />

    <!-- Regions expose editable silhouette volumes without replacing the Paths. -->
    <Region id="head_volume" role="head" type="ellipse"
            center="face_center" radiusX="72" radiusY="88" />
    <Region id="ribcage_volume" role="ribcage" type="capsule"
            from="chest_top" to="waist" width="168" />
    <Region id="pelvis_volume" role="pelvis" type="ellipse"
            center="pelvis" radiusX="82" radiusY="54" />

    <!-- Constraints are used by validation, correction, and the action solver. -->
    <Constraint type="symmetry" left="left_eye" right="right_eye" axis="body_center" />
    <Constraint type="symmetry" left="left_shoulder" right="right_shoulder" axis="body_center" />
    <Constraint type="distance" from="left_eye" to="right_eye" value="0.78eyeWidth" />
    <Constraint type="angleLimit" bone="left_forearm" min="-155" max="155" />
    <Constraint type="angleLimit" bone="right_forearm" min="-155" max="155" />
    <Constraint type="lengthRatio" bone="left_forearm" relativeTo="left_upper_arm" value="0.92" />
    <Constraint type="lengthRatio" bone="right_forearm" relativeTo="right_upper_arm" value="0.92" />

    <Guide id="face_vertical" type="line" through="face_center" angle="90" />
    <Guide id="eye_horizontal" type="line" through="eye_line" angle="0" />
    <Control id="left_hand_control" type="ik" target="left_hand" chainLength="2" />
    <Control id="right_hand_control" type="ik" target="right_hand" chainLength="2" />
    <Control id="look_control" type="aim" targets={["left_eye","right_eye"]} />
  </Skeleton>

  <Action id="hero_idle" skeleton="hero_rig" duration="6s">
    <Pose t="0">
      <Bone id="chest" rotation="-1" />
      <Bone id="head" rotation="1" />
      <Bone id="left_upper_arm" rotation="-5" />
      <Bone id="right_upper_arm" rotation="5" />
    </Pose>
    <Pose t="3">
      <Bone id="chest" rotation="2" />
      <Bone id="head" rotation="-2" />
      <Bone id="left_upper_arm" rotation="2" />
      <Bone id="right_upper_arm" rotation="-2" />
    </Pose>
    <Pose t="6">
      <Bone id="chest" rotation="-1" />
      <Bone id="head" rotation="1" />
      <Bone id="left_upper_arm" rotation="-5" />
      <Bone id="right_upper_arm" rotation="5" />
    </Pose>
  </Action>

  <Scene id="profile_driven_character_rig">
    <Defs>
      <LinearGradient id="panel_gradient" x1="0" y1="0" x2="1" y2="1"
                      stops="0:#17202A, 1:#273746" />
      <LinearGradient id="dress_gradient" x1="0" y1="0" x2="0" y2="1"
                      stops="0:#ED6A8A, 1:#A92E62" />
      <LinearGradient id="hair_gradient" x1="0" y1="0" x2="1" y2="1"
                      stops="0:#5A3B78, 0.55:#2B1B4A, 1:#160F2C" />
    </Defs>
    <Timeline>
      <Track id="stage" space="screen" z="0">
        <Sequence from="0s" duration="6s" out="hold">
          <Layer>
            <Rect x="0" y="0" width="1280" height="900" color="#F2EEE7" />
            <Rect x="770" y="44" width="466" height="812" radius="34" fill="url(#panel_gradient)" />
            <Text x="54" y="66" value="PROFILE-DRIVEN CHARACTER 2D" fontSize="30" fontWeight="800" color="#24313C" />
            <Text x="56" y="102" value="anime_6_head / semantic rig / validation / IK-ready controls" fontSize="17" color="#66727C" />

            <Character id="hero_character" rig="hero_rig" x="430" y="754" scale="1" opacity="1">
              <Part id="pelvis_art" attachTo="pelvis">
                <Path d="M -70 -34 C -44 -60 44 -60 70 -34 L 58 62 C 24 82 -24 82 -58 62 Z"
                      fill="#832650" stroke="#3A1735" strokeWidth="5" />
              </Part>
              <Part id="torso_art" attachTo="chest">
                <Path d="M -82 -48 C -54 -72 54 -72 82 -48 C 102 4 96 94 64 150 C 28 174 -28 174 -64 150 C -96 94 -102 4 -82 -48 Z"
                      fill="url(#dress_gradient)" stroke="#3A1735" strokeWidth="6" />
                <Path d="M -70 -34 C -30 -8 30 -8 70 -34" fill="none" stroke="#F6B1C1" strokeWidth="10" opacity="0.7" />
              </Part>
              <Part id="neck_art" attachTo="neck">
                <Path d="M -24 -20 L 24 -20 L 34 70 L -34 70 Z" fill="#F1C8B5" />
              </Part>
              <Part id="head_art" attachTo="head">
                <Path d="M -70 -36 C -62 -86 62 -86 70 -36 L 64 30 C 46 84 -46 84 -64 30 Z"
                      fill="#F6D5C6" stroke="#3A1735" strokeWidth="5" />
                <Path d="M -72 -30 C -66 -102 66 -106 82 -34 C 50 -64 16 -68 -8 -36 C -24 -66 -44 -68 -72 -30 Z"
                      fill="url(#hair_gradient)" />
                <Path d="M -66 -16 C -46 -34 -20 -34 -2 -16" fill="none" stroke="#3A1735" strokeWidth="6" />
                <Path d="M 4 -16 C 24 -34 50 -32 64 -14" fill="none" stroke="#3A1735" strokeWidth="6" />
                <Ellipse x="-29" y="-8" radiusX="14" radiusY="19" color="#FFFFFF" stroke="#3A1735" strokeWidth="4" />
                <Ellipse x="31" y="-8" radiusX="14" radiusY="19" color="#FFFFFF" stroke="#3A1735" strokeWidth="4" />
                <Circle x="-27" y="-5" radius="7" color="#4D72C9" />
                <Circle x="29" y="-5" radius="7" color="#4D72C9" />
                <Circle x="-27" y="-5" radius="3" color="#142A4F" />
                <Circle x="29" y="-5" radius="3" color="#142A4F" />
                <Path d="M 0 6 L -4 22 L 4 24" fill="none" stroke="#D49C91" strokeWidth="3" />
                <Path d="M -20 42 C -6 52 8 52 22 40" fill="none" stroke="#A74E62" strokeWidth="4" />
              </Part>
              <Part id="left_upper_arm_art" attachTo="left_upper_arm">
                <Path d="M 0 -18 C -34 -12 -78 22 -108 70 L -82 96 C -40 70 -8 34 10 8 Z"
                      fill="#D64A76" stroke="#3A1735" strokeWidth="5" />
              </Part>
              <Part id="left_forearm_art" attachTo="left_forearm">
                <Path d="M 0 -15 C -28 4 -58 36 -78 78 L -54 96 C -20 70 0 36 10 4 Z"
                      fill="#F3CCBA" stroke="#3A1735" strokeWidth="5" />
              </Part>
              <Part id="left_hand_art" attachTo="left_hand">
                <Ellipse x="0" y="0" radiusX="20" radiusY="27" color="#F3CCBA" stroke="#3A1735" strokeWidth="4" />
              </Part>
              <Part id="right_upper_arm_art" attachTo="right_upper_arm">
                <Path d="M 0 -18 C 34 -12 78 22 108 70 L 82 96 C 40 70 8 34 -10 8 Z"
                      fill="#D64A76" stroke="#3A1735" strokeWidth="5" />
              </Part>
              <Part id="right_forearm_art" attachTo="right_forearm">
                <Path d="M 0 -15 C 28 4 58 36 78 78 L 54 96 C 20 70 0 36 -10 4 Z"
                      fill="#F3CCBA" stroke="#3A1735" strokeWidth="5" />
              </Part>
              <Part id="right_hand_art" attachTo="right_hand">
                <Ellipse x="0" y="0" radiusX="20" radiusY="27" color="#F3CCBA" stroke="#3A1735" strokeWidth="4" />
              </Part>
              <Part id="left_thigh_art" attachTo="left_thigh">
                <Path d="M -30 -12 C -42 42 -36 104 -18 154 L 28 154 C 38 96 38 38 28 -12 Z"
                      fill="#33425C" stroke="#18243A" strokeWidth="5" />
              </Part>
              <Part id="left_shin_art" attachTo="left_shin">
                <Path d="M -20 -6 C -26 44 -24 104 -12 150 L 24 150 C 30 96 28 38 20 -6 Z"
                      fill="#F1C8B5" stroke="#3A1735" strokeWidth="4" />
              </Part>
              <Part id="left_foot_art" attachTo="left_foot">
                <Path d="M -20 -12 L 30 -12 C 54 0 66 16 58 30 L -28 30 Z" fill="#422B55" stroke="#21152D" strokeWidth="5" />
              </Part>
              <Part id="right_thigh_art" attachTo="right_thigh">
                <Path d="M -28 -12 C -38 38 -38 96 -28 154 L 18 154 C 36 104 42 42 30 -12 Z"
                      fill="#33425C" stroke="#18243A" strokeWidth="5" />
              </Part>
              <Part id="right_shin_art" attachTo="right_shin">
                <Path d="M -20 -6 C -28 38 -30 96 -24 150 L 12 150 C 24 104 26 44 20 -6 Z"
                      fill="#F1C8B5" stroke="#3A1735" strokeWidth="4" />
              </Part>
              <Part id="right_foot_art" attachTo="right_foot">
                <Path d="M -30 -12 L 20 -12 L 28 30 L -58 30 C -66 16 -54 0 -30 -12 Z" fill="#422B55" stroke="#21152D" strokeWidth="5" />
              </Part>
            </Character>

            <!-- Visible editor-style construction overlay for the same 6-head profile. -->
            <Group id="profile_overlay_group">
              <Text x="814" y="96" value="RIG VALIDATION OVERLAY" fontSize="22" fontWeight="800" color="#D8FF2F" />
              <Text x="814" y="130" value="anime_6_head / strict / auto-correct" fontSize="15" color="#B7C4CF" />
              <Line x1="995" y1="168" x2="995" y2="790" stroke="#D8FF2F" strokeWidth="2" opacity="0.42" />
              <Line x1="830" y1="250" x2="1160" y2="250" stroke="#7AB7FF" strokeWidth="2" opacity="0.46" />
              <Ellipse x="995" y="250" radiusX="66" radiusY="80" fill="#7AB7FF12" stroke="#7AB7FF" strokeWidth="3" />
              <Path d="M 995 330 L 995 602" fill="none" stroke="#D8FF2F" strokeWidth="7" />
              <Path d="M 995 380 L 862 500 M 995 380 L 1128 500" fill="none" stroke="#D8FF2F" strokeWidth="6" />
              <Path d="M 995 602 L 914 784 M 995 602 L 1076 784" fill="none" stroke="#D8FF2F" strokeWidth="7" />
              <Circle x="995" y="330" radius="8" color="#F2EEE7" stroke="#D8FF2F" strokeWidth="3" />
              <Circle x="995" y="380" radius="8" color="#F2EEE7" stroke="#D8FF2F" strokeWidth="3" />
              <Circle x="995" y="602" radius="8" color="#F2EEE7" stroke="#D8FF2F" strokeWidth="3" />
              <Circle x="862" y="500" radius="9" color="#F2EEE7" stroke="#7AB7FF" strokeWidth="3" />
              <Circle x="1128" y="500" radius="9" color="#F2EEE7" stroke="#7AB7FF" strokeWidth="3" />
              <Text x="814" y="826" value="Landmarks + Regions + Constraints + Guides + Controls" fontSize="14" color="#B7C4CF" />
            </Group>
          </Layer>
        </Sequence>
      </Track>
    </Timeline>
  </Scene>

  <ApplyAction target="hero_character" action="hero_idle" at="0s" loop="true" />
  <Present from="profile_driven_character_rig" />
</Graph>
