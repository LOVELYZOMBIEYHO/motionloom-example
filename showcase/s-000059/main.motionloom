<!--
========================================================================
NOVA CITY - MOTIONLOOM CAPABILITY SHOWCASE
20 s, 1920x1080, 30 fps: component gallery, era gallery, transition lab,
stress test with debug overlay. Self-contained (no imports).

SECTION MAP
- 0-5s    Component Gallery: 4 Component/Use instances + bar/line/radial
          charts + sensor network + subtitle panel, each labeled.
- 5-10s   Era Gallery: five era cards in a timed sequence, each with its
          own palette, density, chart geometry, and texture treatment.
- 10-15s  Transition Lab: CRT geometry glitch, digital scan mask, map
          path morph, energy pulse/whiteout - all deterministic.
- 15-20s  Stress Test + Debug Overlay: 25x20 buildings (500), 40x25
          sensor dots (1000), 8 animated routes, moving camera, and a
          debug overlay with fixed labels and numeric progress geometry.

DATA NOTE: chart endpoints reuse the NOVA CITY contract values and the
same scale mapping documented in showcase/s-000058 (460 px = 100% bars,
radial trim = value/100, 420 px = 6.5M population).
========================================================================
-->
<Graph fps={30} duration="20s" size={[1920,1080]} renderSize={[1920,1080]}>
  <Background color="#05070D" />
  <Scene id="nova_city_capability_showcase">
    <Defs>
      <LinearGradient id="scan_reveal_grad" x1="0" y1="0" x2="1" y2="0"
                      stops="0:#22D3EE00, 0.35:#22D3EE, 0.65:#F472B6, 1:#F472B600" />
      <LinearGradient id="pop_bar_grad" x1="0" y1="1" x2="0" y2="0"
                      stops="0:#0E7490, 1:#67E8F9" />
      <LinearGradient id="gold_grad" x1="0" y1="0" x2="1" y2="0"
                      stops="0:#FDE68A, 0.5:#FB923C, 1:#F472B6" />
      <RadialGradient id="energy_core_grad" cx="0.5" cy="0.5" r="0.5"
                      stops="0:#FFFFFF, 0.35:#A5F3FC, 0.75:#22D3EE55, 1:#22D3EE00" />
      <RadialGradient id="vignette_grad" cx="0.5" cy="0.5" r="0.72"
                      stops="0:#00000000, 0.62:#00000000, 1:#000000C4" />

      <Filter id="lab_glitch_filter">
        <ChromaticAberration
          radius={curve("0:0.6:linear, 1:8:ease_out, 1.4:0.6:ease_in, 3:0.6:linear, 3.8:9:ease_out, 4.2:0.6:ease_in, 5:0.6:linear")}
          amount="0.9" />
      </Filter>

      <Mask id="lab_scan_mask" shape="circle"
            x={curve("0.5:1020:linear, 3.5:1760:linear")}
            y="390" radius="170" feather="30" opacity="1" />

      <Component id="sensor_glyph_component">
        <Group id="sensor_glyph_root">
          <Circle x="24" y="24" radius="5" color="#67E8F9" />
          <Circle x="24" y="24" radius="13" fill="none" stroke="#67E8F9" strokeWidth="2" opacity="0.75" />
          <Line x1="4" y1="24" x2="44" y2="24" stroke="#67E8F9" strokeWidth="1" opacity="0.45" />
          <Line x1="24" y1="4" x2="24" y2="44" stroke="#67E8F9" strokeWidth="1" opacity="0.45" />
        </Group>
      </Component>
      <Component id="building_module_component">
        <Group id="building_module_root">
          <Rect x="0" y="0" width="60" height="220" fill="#0E1526" stroke="#33507A" strokeWidth="2" />
          <Rect x="0" y="0" width="60" height="10" fill="#1E3A5F" opacity="0.9" />
          <Repeat id="building_module_windows" count="6" x="8" y="22" yStep="31" opacity="0.85" opacityStep="-0.05">
            <Rect x="0" y="0" width="44" height="13" color="#FFE58A" opacity="0.42" />
          </Repeat>
        </Group>
      </Component>
      <Component id="hud_corner_component">
        <Group id="hud_corner_root">
          <Line x1="0" y1="0" x2="44" y2="0" stroke="#67E8F9" strokeWidth="4" opacity="0.9" />
          <Line x1="0" y1="0" x2="0" y2="44" stroke="#67E8F9" strokeWidth="4" opacity="0.9" />
          <Circle x="52" y="52" radius="4" color="#67E8F9" opacity="0.8" />
        </Group>
      </Component>
      <Component id="route_node_component">
        <Group id="route_node_root">
          <Circle x="20" y="20" radius="6" color="#E8F7FF" />
          <Circle x="20" y="20" radius="12" fill="none" stroke="#67E8F9" strokeWidth="2" opacity="0.85" />
          <Circle x="20" y="20" radius="19" fill="none" stroke="#67E8F9" strokeWidth="1" opacity="0.35" />
        </Group>
      </Component>
    </Defs>

    <Timeline>
      <Track id="showcase_camera_track" role="camera" z="1000">
        <Sequence from="0s" duration="20s" out="hold">
          <Camera id="showcase_camera" target="showcase_camera_target" anchorX="50%" anchorY="50%"
                  zoom={curve("0:1:linear, 15:1:linear, 17:1.12:ease_in_out, 20:1.18:ease_in_out")}
                  offsetX={curve("0:0:linear, 15:0:linear, 20:-70:ease_in_out")}
                  offsetY={curve("0:0:linear, 15:0:linear, 20:30:ease_in_out")}
                  worldBounds="0,0,1920,1080" />
        </Sequence>
      </Track>

      <Track id="showcase_world_track" space="world" z="0">
        <Sequence from="0s" duration="5s" out="hide">
          <!-- SECTION 1 - COMPONENT GALLERY (0-5s). -->
          <Layer>
            <Circle id="showcase_camera_target" x="960" y="540" radius="2" color="#FFFFFF" opacity="0" />
            <Text value="MOTIONLOOM COMPONENT GALLERY" x="60" y="96" fontSize="40" fontWeight="900" renderScale="4x" color="#E8F7FF" />
            <Text value="REUSABLE FIXED ARTWORK + SEMANTIC CHART GROUPS - MOTIONLOOM DSL"
                  x="60" y="144" fontSize="18" textGap="3" color="#8CA3B8" />

            <!-- Cell 1: sensor glyph component. -->
            <Group id="gallery_cell_sensor" x="60"
                   y={curve("0:190:linear, 0.5:160:ease_out")}
                   opacity={curve("0:0:linear, 0.5:1:ease_out")}>
              <Rect x="0" y="0" width="560" height="260" radius="20" fill="#0B1220" stroke="#1E293B" strokeWidth="2" />
              <Text value="sensor_glyph_component" x="24" y="38" fontSize="20" fontWeight="800" color="#67E8F9" />
              <Text value="Use: mesh node at any scale" x="24" y="62" fontSize="14" textGap="1" color="#8CA3B8" />
              <Use id="gallery_sensor_a" ref="sensor_glyph_component" x="80" y="110" opacity="0.9" />
              <Use id="gallery_sensor_b" ref="sensor_glyph_component" x="200" y="98" scale="1.5" opacity="0.95" />
              <Use id="gallery_sensor_c" ref="sensor_glyph_component" x="380" y="86" scale="2" />
            </Group>

            <!-- Cell 2: building module component. -->
            <Group id="gallery_cell_building" x="680"
                   y={curve("0.15:190:linear, 0.65:160:ease_out")}
                   opacity={curve("0.15:0:linear, 0.65:1:ease_out")}>
              <Rect x="0" y="0" width="560" height="260" radius="20" fill="#0B1220" stroke="#1E293B" strokeWidth="2" />
              <Text value="building_module_component" x="24" y="38" fontSize="20" fontWeight="800" color="#67E8F9" />
              <Text value="Use: towers, skyline rows" x="24" y="62" fontSize="14" textGap="1" color="#8CA3B8" />
              <Use id="gallery_building_a" ref="building_module_component" x="80" y="95" scale="0.73" opacity="0.95" />
              <Use id="gallery_building_b" ref="building_module_component" x="220" y="80" scale="0.8" opacity="0.9" />
              <Use id="gallery_building_c" ref="building_module_component" x="380" y="119" scale="0.62" opacity="0.85" />
            </Group>

            <!-- Cell 3: hud corner component as a mini frame. -->
            <Group id="gallery_cell_hud" x="1300"
                   y={curve("0.3:190:linear, 0.8:160:ease_out")}
                   opacity={curve("0.3:0:linear, 0.8:1:ease_out")}>
              <Rect x="0" y="0" width="560" height="260" radius="20" fill="#0B1220" stroke="#1E293B" strokeWidth="2" />
              <Text value="hud_corner_component" x="24" y="38" fontSize="20" fontWeight="800" color="#67E8F9" />
              <Text value="Use: frame brackets, flipped instances" x="24" y="62" fontSize="14" textGap="1" color="#8CA3B8" />
              <Rect x="80" y="90" width="400" height="140" radius="12" fill="#05070D" stroke="#1E293B" strokeWidth="1" />
              <Use id="gallery_hud_tl" ref="hud_corner_component" x="64" y="74" opacity="0.95" />
              <Use id="gallery_hud_tr" ref="hud_corner_component" x="440" y="74" scaleX="-1" transformOriginX="28" opacity="0.95" />
              <Use id="gallery_hud_bl" ref="hud_corner_component" x="64" y="174" scaleY="-1" transformOriginY="28" opacity="0.95" />
              <Use id="gallery_hud_br" ref="hud_corner_component" x="440" y="174" scaleX="-1" scaleY="-1" transformOriginX="28" transformOriginY="28" opacity="0.95" />
            </Group>

            <!-- Cell 4: route node component on a fixed route. -->
            <Group id="gallery_cell_route" x="60"
                   y={curve("0.45:490:linear, 0.95:460:ease_out")}
                   opacity={curve("0.45:0:linear, 0.95:1:ease_out")}>
              <Rect x="0" y="0" width="560" height="260" radius="20" fill="#0B1220" stroke="#1E293B" strokeWidth="2" />
              <Text value="route_node_component" x="24" y="38" fontSize="20" fontWeight="800" color="#67E8F9" />
              <Text value="Use: metro hubs, energy nodes" x="24" y="62" fontSize="14" textGap="1" color="#8CA3B8" />
              <Path d="M 60 160 L 500 160" stroke="#1D4ED8" strokeWidth="3" fill="none"
                    trimEnd={curve("1:0:linear, 2:1:ease_in_out")} />
              <Use id="gallery_route_a" ref="route_node_component" x="40" y="140" opacity={curve("1.8:0:linear, 2.2:1:ease_out")} />
              <Use id="gallery_route_b" ref="route_node_component" x="260" y="140" scale="1.3" opacity={curve("1.8:0:linear, 2.2:1:ease_out")} />
              <Use id="gallery_route_c" ref="route_node_component" x="480" y="140" opacity={curve("1.8:0:linear, 2.2:1:ease_out")} />
            </Group>

            <!-- Cell 5: bar chart group (PCT scale: 200 px = 100%). -->
            <Group id="bar_chart_group" x="680"
                   y={curve("0.6:490:linear, 1.1:460:ease_out")}
                   opacity={curve("0.6:0:linear, 1.1:1:ease_out")}>
              <Rect x="0" y="0" width="560" height="260" radius="20" fill="#0B1220" stroke="#1E293B" strokeWidth="2" />
              <Text value="bar_chart_group" x="24" y="38" fontSize="20" fontWeight="800" color="#67E8F9" />
              <Text value="PCT scale: 200 px = 100%" x="24" y="62" fontSize="14" textGap="1" color="#8CA3B8" />
              <Rect x="80" width="60"
                    height={curve("2:0:linear, 3:122:ease_out")}
                    y={curve("2:220:linear, 3:98:ease_out")}
                    fill="url(#pop_bar_grad)" />
              <Rect x="240" width="60"
                    height={curve("2.2:0:linear, 3.2:188:ease_out")}
                    y={curve("2.2:220:linear, 3.2:32:ease_out")}
                    fill="url(#pop_bar_grad)" opacity="0.9" />
              <Rect x="400" width="60"
                    height={curve("2.4:0:linear, 3.4:92:ease_out")}
                    y={curve("2.4:220:linear, 3.4:128:ease_out")}
                    fill="url(#pop_bar_grad)" opacity="0.8" />
              <Text value="61 / 94 / 46" x="80" y="246" fontSize="16" textGap="2" color="#8CA3B8" />
            </Group>

            <!-- Cell 6: line chart group. -->
            <Group id="line_chart_group" x="1300"
                   y={curve("0.75:490:linear, 1.25:460:ease_out")}
                   opacity={curve("0.75:0:linear, 1.25:1:ease_out")}>
              <Rect x="0" y="0" width="560" height="260" radius="20" fill="#0B1220" stroke="#1E293B" strokeWidth="2" />
              <Text value="line_chart_group" x="24" y="38" fontSize="20" fontWeight="800" color="#67E8F9" />
              <Text value="trend reveal with Path trim" x="24" y="62" fontSize="14" textGap="1" color="#8CA3B8" />
              <Line x1="60" y1="220" x2="500" y2="220" stroke="#1E293B" strokeWidth="2" />
              <Path d="M 60 200 L 150 160 L 240 185 L 330 120 L 420 90"
                    fill="none" stroke="#34D399" strokeWidth="5" lineCap="round" lineJoin="round"
                    trimEnd={curve("2.2:0:linear, 3.6:1:ease_in_out")} />
              <Circle x="420" y="90" radius="7" color="#E8F7FF" opacity={curve("3.4:0:linear, 3.8:1:ease_out")} />
            </Group>

            <!-- Cell 7: radial chart group (trim = value/100). -->
            <Group id="radial_chart_group" x="60"
                   y={curve("0.9:790:linear, 1.4:760:ease_out")}
                   opacity={curve("0.9:0:linear, 1.4:1:ease_out")}>
              <Rect x="0" y="0" width="560" height="260" radius="20" fill="#0B1220" stroke="#1E293B" strokeWidth="2" />
              <Text value="radial_chart_group" x="24" y="38" fontSize="20" fontWeight="800" color="#67E8F9" />
              <Text value="trimEnd = value / 100 of full circle" x="24" y="62" fontSize="14" textGap="1" color="#8CA3B8" />
              <Circle x="140" y="160" radius="58" fill="none" stroke="#12324A" strokeWidth="12" />
              <Path d="M 140 102 C 172 102, 198 128, 198 160 C 198 192, 172 218, 140 218 C 108 218, 82 192, 82 160 C 82 128, 108 102, 140 102"
                    fill="none" stroke="#38BDF8" strokeWidth="12" lineCap="round"
                    trimEnd={curve("2.4:0:linear, 3.8:0.61:ease_in_out")} />
              <Text value="61%" x="116" y="172" fontSize="28" fontWeight="800" color="#E8F7FF"
                    opacity={curve("3.6:0:linear, 4:1:ease_out")} />
              <Circle x="360" y="160" radius="58" fill="none" stroke="#123C2A" strokeWidth="12" />
              <Path d="M 360 102 C 392 102, 418 128, 418 160 C 418 192, 392 218, 360 218 C 328 218, 302 192, 302 160 C 302 128, 328 102, 360 102"
                    fill="none" stroke="#4ADE80" strokeWidth="12" lineCap="round"
                    trimEnd={curve("2.6:0:linear, 4:0.96:ease_in_out")} />
              <Text value="96%" x="336" y="172" fontSize="28" fontWeight="800" color="#E8F7FF"
                    opacity={curve("3.8:0:linear, 4.2:1:ease_out")} />
            </Group>

            <!-- Cell 8: sensor network group. -->
            <Group id="sensor_network_group" x="680"
                   y={curve("1.05:790:linear, 1.55:760:ease_out")}
                   opacity={curve("1.05:0:linear, 1.55:1:ease_out")}>
              <Rect x="0" y="0" width="560" height="260" radius="20" fill="#0B1220" stroke="#1E293B" strokeWidth="2" />
              <Text value="sensor_network_group" x="24" y="38" fontSize="20" fontWeight="800" color="#67E8F9" />
              <Text value="glyph mesh + data links" x="24" y="62" fontSize="14" textGap="1" color="#8CA3B8" />
              <Path d="M 124 130 L 424 130 M 124 210 L 424 210 M 124 130 L 424 210 M 424 130 L 124 210"
                    stroke="#34D399" strokeWidth="2" fill="none" opacity="0.6"
                    trimEnd={curve("2:0:linear, 3.2:1:ease_in_out")} />
              <Use id="gallery_mesh_a" ref="sensor_glyph_component" x="100" y="106" opacity={curve("2.8:0:linear, 3.2:1:ease_out")} />
              <Use id="gallery_mesh_b" ref="sensor_glyph_component" x="400" y="106" opacity={curve("2.8:0:linear, 3.2:1:ease_out")} />
              <Use id="gallery_mesh_c" ref="sensor_glyph_component" x="100" y="186" opacity={curve("3:0:linear, 3.4:1:ease_out")} />
              <Use id="gallery_mesh_d" ref="sensor_glyph_component" x="400" y="186" opacity={curve("3:0:linear, 3.4:1:ease_out")} />
            </Group>

            <!-- Cell 9: subtitle panel. -->
            <Group id="subtitle_group" x="1300"
                   y={curve("1.2:790:linear, 1.7:760:ease_out")}
                   opacity={curve("1.2:0:linear, 1.7:1:ease_out")}>
              <Rect x="0" y="0" width="560" height="260" radius="20" fill="#0B1220" stroke="#1E293B" strokeWidth="2" />
              <Text value="subtitle_group" x="24" y="38" fontSize="20" fontWeight="800" color="#67E8F9" />
              <Text value="fixed text, timed opacity, panel backer" x="24" y="62" fontSize="14" textGap="1" color="#8CA3B8" />
              <Rect x="40" y="100" width="480" height="110" radius="14" fill="#05070D" stroke="#1E293B" strokeWidth="1" opacity="0.85" />
              <Rect x="40" y="100" width="6" height="110" fill="#F472B6" />
              <Text value="EVERY DATA POINT HAS A VOICE." x="72" y="142" fontSize="20" fontWeight="700" color="#E8F7FF" />
              <Text value="CAPTION SYSTEM - MOTIONLOOM" x="72" y="176" fontSize="14" textGap="3" color="#8CA3B8" />
            </Group>
          </Layer>
        </Sequence>

        <Sequence from="5s" duration="5s" out="hide">
          <!-- SECTION 2 - ERA GALLERY (5-10s). -->
          <Layer>
            <Text value="ERA GALLERY - FIVE DECADES" x="60" y="100" fontSize="40" fontWeight="900" renderScale="4x" color="#E8F7FF" />
            <Text value="TIMED GALLERY - ONE CITY, FIVE DATA IDENTITIES" x="60" y="144" fontSize="18" textGap="3" color="#8CA3B8" />

            <Group id="era_card_1980" x="110"
                   y={curve("0.2:260:linear, 0.7:220:ease_out")}
                   opacity={curve("0.2:0:linear, 0.7:1:ease_out")}>
              <Rect x="0" y="0" width="300" height="420" radius="18" fill="#14100B" stroke="#8A5A2B" strokeWidth="2" />
              <Rect x="0" y="0" width="300" height="6" fill="#FFB454" />
              <Text value="1980" x="24" y="86" fontSize="54" fontWeight="900" color="#FFB454" />
              <Text value="INDUSTRIAL" x="24" y="128" fontSize="16" textGap="4" color="#8CA3B8" />
              <Repeat id="era1980_texture" count="5" x="24" y="150" yStep="26" opacity="0.5" opacityStep="-0.04">
                <Line x1="0" y1="0" x2="252" y2="0" stroke="#FFB454" strokeWidth="1" />
              </Repeat>
              <Rect x="24" y="300" width="40" height="34" fill="#8A5A2B" />
              <Rect x="76" y="280" width="40" height="54" fill="#A66A2B" />
              <Rect x="128" y="316" width="40" height="18" fill="#6B4A2A" />
              <Text value="RENEWABLE 4%" x="24" y="380" fontSize="20" fontWeight="700" color="#E8B26A" />
              <Text value="BAR + SCANLINE TEXTURE" x="24" y="404" fontSize="13" textGap="2" color="#8CA3B8" />
            </Group>

            <Group id="era_card_2000" x="450"
                   y={curve("0.9:260:linear, 1.4:220:ease_out")}
                   opacity={curve("0.9:0:linear, 1.4:1:ease_out")}>
              <Rect x="0" y="0" width="300" height="420" radius="18" fill="#0B1730" stroke="#38BDF8" strokeWidth="2" />
              <Rect x="0" y="0" width="300" height="6" fill="#38BDF8" />
              <Text value="2000" x="24" y="86" fontSize="54" fontWeight="900" color="#38BDF8" />
              <Text value="DIGITAL" x="24" y="128" fontSize="16" textGap="4" color="#8CA3B8" />
              <Repeat id="era2000_texture" count="3" x="220" y="150" yStep="34" opacity="0.7">
                <Repeat count="2" xStep="34" opacity="0.8">
                  <Rect x="0" y="0" width="24" height="24" fill="none" stroke="#38BDF8" strokeWidth="1.5" />
                </Repeat>
              </Repeat>
              <Circle x="150" y="290" radius="56" fill="none" stroke="#12324A" strokeWidth="10" />
              <Path d="M 150 234 C 180.9 234, 206 259.1, 206 290 C 206 320.9, 180.9 346, 150 346 C 119.1 346, 94 320.9, 94 290 C 94 259.1, 119.1 234, 150 234"
                    fill="none" stroke="#38BDF8" strokeWidth="10" lineCap="round"
                    trimEnd={curve("1.4:0:linear, 2.8:0.61:ease_in_out")} />
              <Text value="INTERNET 61%" x="24" y="380" fontSize="20" fontWeight="700" color="#7DD3FC" />
              <Text value="RADIAL + GRID TEXTURE" x="24" y="404" fontSize="13" textGap="2" color="#8CA3B8" />
            </Group>

            <Group id="era_card_2025" x="790"
                   y={curve("1.6:260:linear, 2.1:220:ease_out")}
                   opacity={curve("1.6:0:linear, 2.1:1:ease_out")}>
              <Rect x="0" y="0" width="300" height="420" radius="18" fill="#0A1F1A" stroke="#34D399" strokeWidth="2" />
              <Rect x="0" y="0" width="300" height="6" fill="#34D399" />
              <Text value="2025" x="24" y="86" fontSize="54" fontWeight="900" color="#34D399" />
              <Text value="SMART" x="24" y="128" fontSize="16" textGap="4" color="#8CA3B8" />
              <ParticleField id="era2025_texture" x="24" y="150" width="252" height="180"
                             count="42" minSize="1" maxSize="3" minOpacity="0.2" maxOpacity="0.8"
                             color="#6EE7B7" seed="2025" />
              <Rect x="24" y="300" width="34" height="46" fill="url(#pop_bar_grad)" />
              <Rect x="68" y="268" width="34" height="78" fill="url(#pop_bar_grad)" opacity="0.85" />
              <Rect x="112" y="320" width="34" height="26" fill="url(#pop_bar_grad)" opacity="0.7" />
              <Text value="DEVICES 12.4M" x="24" y="380" fontSize="20" fontWeight="700" color="#6EE7B7" />
              <Text value="BAR + DOT FIELD TEXTURE" x="24" y="404" fontSize="13" textGap="2" color="#8CA3B8" />
            </Group>

            <Group id="era_card_2035" x="1130"
                   y={curve("2.3:260:linear, 2.8:220:ease_out")}
                   opacity={curve("2.3:0:linear, 2.8:1:ease_out")}>
              <Rect x="0" y="0" width="300" height="420" radius="18" fill="#17122B" stroke="#A78BFA" strokeWidth="2" />
              <Rect x="0" y="0" width="300" height="6" fill="#A78BFA" />
              <Text value="2035" x="24" y="86" fontSize="54" fontWeight="900" color="#A78BFA" />
              <Text value="VERTICAL" x="24" y="128" fontSize="16" textGap="4" color="#8CA3B8" />
              <Repeat id="era2035_texture" count="6" x="28" y="340" xStep="42" scale="1" scaleStep="0.14" opacity="0.85">
                <Rect x="0" y="-150" width="22" height="150" fill="#A78BFA" opacity="0.75" />
              </Repeat>
              <Text value="GREEN 51%" x="24" y="380" fontSize="20" fontWeight="700" color="#4ADE80" />
              <Text value="VERTICAL BARS TEXTURE" x="24" y="404" fontSize="13" textGap="2" color="#8CA3B8" />
            </Group>

            <Group id="era_card_2050" x="1470"
                   y={curve("3:260:linear, 3.5:220:ease_out")}
                   opacity={curve("3:0:linear, 3.5:1:ease_out")}>
              <Rect x="0" y="0" width="300" height="420" radius="18" fill="#241A08" stroke="#FDE68A" strokeWidth="2" />
              <Rect x="0" y="0" width="300" height="6" fill="#FDE68A" />
              <Text value="2050" x="24" y="86" fontSize="54" fontWeight="900" color="#FDE68A" />
              <Text value="ZERO-CARBON" x="24" y="128" fontSize="16" textGap="4" color="#8CA3B8" />
              <Path d="M 60 330 C 60 280, 106.9 260, 150 260 C 193.1 260, 240 280, 240 330"
                    stroke="#FDE68A" strokeWidth="7" fill="none" lineCap="round"
                    trimEnd={curve("3.2:0:linear, 4.4:1:ease_in_out")} />
              <Repeat id="era2050_rays" count="5" x="150" y="320" rotation="-60" rotationStep="30" opacity="0.8">
                <Line x1="0" y1="0" x2="0" y2="-24" stroke="#FDE68A" strokeWidth="3" />
              </Repeat>
              <Text value="RENEWABLE 96%" x="24" y="380" fontSize="20" fontWeight="700" color="#FBBF24" />
              <Text value="ARC + RAY TEXTURE" x="24" y="404" fontSize="13" textGap="2" color="#8CA3B8" />
            </Group>

            <!-- Gallery timeline rail with a moving progress node. -->
            <Group id="era_gallery_rail">
              <Line x1="260" y1="760" x2="1620" y2="760" stroke="#1E293B" strokeWidth="3" />
              <Use id="rail_node_1980" ref="route_node_component" x="240" y="740" opacity="0.9" />
              <Use id="rail_node_2000" ref="route_node_component" x="580" y="740" opacity="0.9" />
              <Use id="rail_node_2025" ref="route_node_component" x="920" y="740" opacity="0.9" />
              <Use id="rail_node_2035" ref="route_node_component" x="1260" y="740" opacity="0.9" />
              <Use id="rail_node_2050" ref="route_node_component" x="1600" y="740" opacity="0.9" />
              <Circle x={curve("0.8:260:linear, 4.5:1620:ease_in_out")} y="760" radius="9" color="#FFFFFF" />
              <Text value="1980" x="238" y="806" fontSize="16" color="#8CA3B8" />
              <Text value="2000" x="578" y="806" fontSize="16" color="#8CA3B8" />
              <Text value="2025" x="918" y="806" fontSize="16" color="#8CA3B8" />
              <Text value="2035" x="1258" y="806" fontSize="16" color="#8CA3B8" />
              <Text value="2050" x="1598" y="806" fontSize="16" color="#8CA3B8" />
            </Group>
          </Layer>
        </Sequence>

        <Sequence from="10s" duration="5s" out="hide">
          <!-- SECTION 3 - TRANSITION LAB (10-15s). -->
          <Layer>
            <Text value="TRANSITION LAB" x="60" y="100" fontSize="40" fontWeight="900" renderScale="4x" color="#E8F7FF" />
            <Text value="FOUR DETERMINISTIC MOTIONLOOM TRANSITIONS" x="60" y="144" fontSize="18" textGap="3" color="#8CA3B8" />

            <!-- Q1: CRT geometry glitch. -->
            <Group id="lab_q1_glitch" effects={["lab_glitch_filter"]}>
              <Rect x="80" y="180" width="880" height="380" radius="20" fill="#14100B" stroke="#8A5A2B" strokeWidth="2" />
              <Text value="CRT GEOMETRY GLITCH" x="112" y="224" fontSize="20" fontWeight="800" textGap="2" color="#FFB454" />
              <Use id="lab_glitch_tower_a" ref="building_module_component" x="200" y="300" scale="0.9" opacity="0.95" />
              <Use id="lab_glitch_tower_b" ref="building_module_component" x="330" y="260" scale="1.1" opacity="0.9" />
              <Use id="lab_glitch_tower_c" ref="building_module_component" x="470" y="320" scale="0.8" opacity="0.85" />
              <Rect x="120 + random(-26,26,floor($time.sec*11)+7)" y="300" width="240" height="6" color="#FFFFFF"
                    opacity={curve("0:0:linear, 0.96:0:linear, 1:0.7:ease_out, 1.3:0:ease_in, 3.76:0:linear, 3.8:0.7:ease_out, 4.1:0:ease_in, 5:0:linear")} />
              <Rect x="500 + random(-30,30,floor($time.sec*9)+19)" y="430" width="200" height="5" color="#FFB454"
                    opacity={curve("0:0:linear, 1.02:0:linear, 1.06:0.6:ease_out, 1.34:0:ease_in, 3.82:0:linear, 3.86:0.6:ease_out, 4.14:0:ease_in, 5:0:linear")} />
              <Text value="SEEDED SLICES + CHROMATIC FILTER" x="112" y="528" fontSize="14" textGap="2" color="#8CA3B8" />
            </Group>

            <!-- Q2: digital scan mask (direct Layer child so the mask applies). -->
            <Group id="lab_q2_scan">
              <Rect x="960" y="180" width="880" height="380" radius="20" fill="#0B1730" stroke="#38BDF8" strokeWidth="2" />
              <Text value="DIGITAL SCAN MASK" x="992" y="224" fontSize="20" fontWeight="800" textGap="2" color="#38BDF8" />
              <Text value="CURVE-DRIVEN MASK + TRACKER" x="992" y="528" fontSize="14" textGap="2" color="#8CA3B8" />
            </Group>
            <Group id="lab_scan_reveal" mask="lab_scan_mask" maskMode="alpha">
              <Rect x="1000" y="250" width="800" height="240" fill="url(#scan_reveal_grad)" opacity="0.9" />
            </Group>
            <Circle id="lab_scan_tracker"
                    x={curve("0.5:1020:linear, 3.5:1760:linear")}
                    y="390" radius="9" color="#FFFFFF" opacity="0.95" />

            <!-- Q3: map path morph (AnimationTarget property="d", keys local to this sequence). -->
            <Group id="lab_q3_morph">
              <Rect x="80" y="620" width="880" height="380" radius="20" fill="#082F3F" stroke="#22D3EE" strokeWidth="2" />
              <Text value="MAP PATH MORPH" x="112" y="664" fontSize="20" fontWeight="800" textGap="2" color="#22D3EE" />
              <Path id="lab_morph_path"
                    d="M 400 700 L 500 730 L 560 800 L 520 880 L 420 910 L 320 880 L 280 800 L 320 730 Z"
                    fill="#0E7490" stroke="#67E8F9" strokeWidth="3" lineJoin="round" opacity="0.95" />
              <Text value="ORGANIC TO STEPPED, KEYED WITH AnimationTarget" x="112" y="968" fontSize="14" textGap="2" color="#8CA3B8" />
            </Group>

            <!-- Q4: energy pulse / whiteout reveal. -->
            <Group id="lab_q4_pulse">
              <Rect x="960" y="620" width="880" height="380" radius="20" fill="#0B1220" stroke="#FDE68A" strokeWidth="2" />
              <Text value="ENERGY PULSE - WHITEOUT" x="992" y="664" fontSize="20" fontWeight="800" textGap="2" color="#FDE68A" />
              <Circle x="1400" y="810" radius="90" fill="url(#energy_core_grad)" blend="screen" opacity="0.9" />
              <Circle x="1400" y="810" color="#FFFFFF"
                    radius={curve("0.4:18:linear, 1.6:150:ease_out, 1.61:18:linear, 2.8:150:ease_out, 2.81:18:linear, 4:150:ease_out, 4.01:18:linear, 5:110:ease_out")}
                    opacity={curve("0.4:0.9:linear, 1.55:0:ease_out, 1.61:0.9:linear, 2.75:0:ease_out, 2.81:0.9:linear, 3.95:0:ease_out, 4.01:0.9:linear, 5:0:ease_out")} />
              <Circle x="1400" y="810" radius="16" color="#FFFFFF" />
              <Rect x="960" y="620" width="880" height="380" radius="20" color="#FFFFFF"
                    opacity={curve("0:0:linear, 1.5:0:linear, 1.56:0.85:ease_out, 1.8:0:ease_in, 2.7:0:linear, 2.76:0.85:ease_out, 3:0:ease_in, 3.9:0:linear, 3.96:0.85:ease_out, 4.2:0:ease_in, 5:0:linear")} />
              <Text value="RADIUS PULSE + OPACITY FLASH" x="992" y="968" fontSize="14" textGap="2" color="#8CA3B8" />
            </Group>
          </Layer>
        </Sequence>

        <Sequence from="15s" duration="5s" out="hide">
          <!-- SECTION 4 - STRESS TEST (15-20s). -->
          <Layer>
            <!-- 1000 sensor dots: 40 columns x 25 rows nested Repeat. -->
            <Repeat id="stress_sensor_rows" count="40" x="24" y="30" xStep="46" opacity="0.55" opacityStep="0">
              <Repeat id="stress_sensor_cols" count="25" yStep="40" opacity="1" opacityStep="0">
                <Circle x="0" y="0" radius="2.5" color="#67E8F9" />
              </Repeat>
            </Repeat>
            <!-- 500 building instances: 25 columns x 20 rows nested Repeat. -->
            <Repeat id="stress_building_cols" count="25" x="30" y="140" xStep="74" opacity="0.92" opacityStep="0">
              <Repeat id="stress_building_rows" count="20" yStep="36" scale="1" scaleStep="-0.02" opacity="0.9" opacityStep="-0.01">
                <Use ref="building_module_component" scale="0.14" />
              </Repeat>
            </Repeat>
            <!-- 8 animated routes from the city core (Group wrapper lets rotationStep render). -->
            <Group id="stress_route_group">
              <Repeat id="stress_routes_8" count="8" x="960" y="540" rotationStep="45" opacity="0.9">
                <Path d="M 0 0 L 0 -380" stroke="#F472B6" strokeWidth="4" fill="none" lineCap="round"
                      trimEnd={curve("0.5:0:linear, 2:1:ease_in_out")} />
              </Repeat>
            </Group>
            <Circle x="960" y="540" radius="26" fill="url(#energy_core_grad)" blend="screen" opacity="0.9" />
          </Layer>
        </Sequence>
      </Track>

      <Track id="debug_overlay_track" space="screen" z="500">
        <Sequence from="15s" duration="5s" out="hide">
          <Layer>
            <Text value="STRESS TEST - 500 BUILDINGS / 1000 SENSORS / 8 ROUTES" x="60" y="80" fontSize="30" fontWeight="900" textGap="2" color="#E8F7FF" />
            <Text value="CAMERA PUSH + PARALLAX FIELD" x="60" y="116" fontSize="18" textGap="3" color="#8CA3B8" />
            <Rect x="0" y="948" width="1920" height="132" fill="#05070D" opacity="0.92" />
            <Line x1="0" y1="948" x2="1920" y2="948" stroke="#1E293B" strokeWidth="2" />
            <Text value="CURRENT TIME" x="60" y="986" fontSize="16" textGap="2" color="#8CA3B8" />
            <Rect x="60" y="1000" width="240" height="12" radius="6" fill="#0B1730" stroke="#1E293B" strokeWidth="1" />
            <Rect x="60" y="1000" height="12" radius="6" fill="#67E8F9"
                  width={curve("0:0:linear, 5:240:linear")} />
            <Text value="ACTIVE SECTION" x="60" y="1052" fontSize="16" textGap="2" color="#8CA3B8" />
            <Text value="STRESS TEST" x="220" y="1052" fontSize="16" fontWeight="800" color="#F472B6" />

            <Text value="CURRENT ERA" x="420" y="986" fontSize="16" textGap="2" color="#8CA3B8" />
            <Text value="2050" x="560" y="986" fontSize="16" fontWeight="800" color="#FDE68A" />
            <Text value="BUILDING INSTANCES" x="420" y="1052" fontSize="16" textGap="2" color="#8CA3B8" />
            <Text value="500" x="640" y="1052" fontSize="16" fontWeight="800" color="#E8F7FF" />

            <Text value="SENSOR INSTANCES" x="800" y="986" fontSize="16" textGap="2" color="#8CA3B8" />
            <Text value="1000" x="990" y="986" fontSize="16" fontWeight="800" color="#E8F7FF" />
            <Text value="RENDER LOAD ESTIMATE" x="800" y="1052" fontSize="16" textGap="2" color="#8CA3B8" />
            <Text value="87%" x="1030" y="1052" fontSize="16" fontWeight="800" color="#FBBF24" />
            <Rect x="1120" y="1040" width="240" height="12" radius="6" fill="#0B1730" stroke="#1E293B" strokeWidth="1" />
            <Rect x="1120" y="1040" width="208.8" height="12" radius="6" fill="#FBBF24" />

            <Text value="MOTIONLOOM STRESS HARNESS" x="1450" y="986" fontSize="16" fontWeight="800" textGap="2" color="#67E8F9" />
            <Text value="8 ANIMATED ROUTES" x="1450" y="1052" fontSize="16" textGap="2" color="#8CA3B8" />
            <Rect x="1640" y="1040" width="240" height="12" radius="6" fill="#0B1730" stroke="#1E293B" strokeWidth="1" />
            <Rect x="1640" y="1040" height="12" radius="6" fill="#F472B6"
                  width={curve("0.5:0:linear, 2:240:ease_in_out")} />
          </Layer>
        </Sequence>
      </Track>

      <Track id="showcase_hud_track" space="screen" z="600">
        <Sequence from="0s" duration="20s" out="hold">
          <Layer>
            <Rect x="0" y="0" width="1920" height="1080" fill="url(#vignette_grad)" opacity="0.8" />
            <Use id="showcase_hud_tl" ref="hud_corner_component" x="28" y="28" opacity="0.85" />
            <Use id="showcase_hud_tr" ref="hud_corner_component" x="1864" y="28" scaleX="-1" transformOriginX="28" opacity="0.85" />
            <Use id="showcase_hud_bl" ref="hud_corner_component" x="28" y="996" scaleY="-1" transformOriginY="28" opacity="0.85" />
            <Use id="showcase_hud_br" ref="hud_corner_component" x="1864" y="996" scaleX="-1" scaleY="-1" transformOriginX="28" transformOriginY="28" opacity="0.85" />
            <Text value="NOVA CITY - MOTIONLOOM SHOWCASE" x="1330" y="58" fontSize="20" fontWeight="800" textGap="3" color="#E8F7FF" opacity="0.9" />
            <Rect x="0" y="1074" width="1920" height="2" fill="#1E293B" opacity="0.8" />
            <Rect x="0" y="1074" height="2" fill="#67E8F9"
                  width={curve("0:0:linear, 20:1920:linear")} />
          </Layer>
        </Sequence>
      </Track>
    </Timeline>
  </Scene>

  <!-- Transition lab path morph: frames are local to the 10-15s sequence. -->
  <AnimationTarget node="lab_morph_path" property="d">
    <Key frame="0" value="M 400 700 L 500 730 L 560 800 L 520 880 L 420 910 L 320 880 L 280 800 L 320 730 Z" />
    <Key frame="60" value="M 400 690 L 520 690 L 520 780 L 570 780 L 570 880 L 470 880 L 470 920 L 300 920 L 300 760 Z" />
    <Key frame="120" value="M 400 700 L 500 730 L 560 800 L 520 880 L 420 910 L 320 880 L 280 800 L 320 730 Z" />
    <Key frame="150" value="M 400 700 L 500 730 L 560 800 L 520 880 L 420 910 L 320 880 L 280 800 L 320 730 Z" />
  </AnimationTarget>

  <Present from="nova_city_capability_showcase" />
</Graph>
