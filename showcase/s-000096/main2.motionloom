<!-- ========================================= -->
<!-- showcase/s-000096/main.motionloom -->
<!-- Imported landscape_forest__mountains.glb: camera-only appreciation. -->
<!-- A morning -> dusk -> night montage: the same short ground-level flight is -->
<!-- played three times at three times of day, hard-cutting between segments. -->
<!-- Style: physical shading, TAA ultra, low card specular; the engine's -->
<!-- default tone mapping stays untouched so the colours read like the raw -->
<!-- playback (see README "Baseline"). Only the night segment swaps the sky -->
<!-- dome's texture for a moonlit derivative of the asset's own painting. -->
<Graph fps={24} duration="15s" size={[1920,1080]} renderSize={[1920,1080]}>
<RenderStyle id="s96_rawplus_morning">
  <SurfaceStyle shading="physical" specular="0.20" />
  <LightingStyle ambientIntensity="1.0" ambientColor="#FFF6E8" shadowStyle="soft" />
  <AntiAliasingStyle method="taa" quality="ultra" fallback="smaa" sharpness="0.06" />
</RenderStyle>
<RenderStyle id="s96_rawplus_dusk">
  <SurfaceStyle shading="physical" specular="0.20" />
  <LightingStyle ambientIntensity="1.05" ambientColor="#E0A070" shadowStyle="soft" />
  <PostStyle exposure="0.95" saturation="1.12" contrast="1.04"
             bloomThreshold="0.90" bloomIntensity="0.14" />
  <ColorStyle tint="#FFD8A8" tintStrength="0.16" saturation="1.02" />
  <AntiAliasingStyle method="taa" quality="ultra" fallback="smaa" sharpness="0.06" />
</RenderStyle>
<RenderStyle id="s96_rawplus_night">
  <SurfaceStyle shading="physical" specular="0.20" />
  <LightingStyle ambientIntensity="0.50" ambientColor="#2A3550" shadowStyle="soft" />
  <PostStyle exposure="0.87" saturation="0.95" contrast="1.02"
             bloomThreshold="0.95" bloomIntensity="0.0" />
  <ColorStyle tint="#9FB4D8" tintStrength="0.22" saturation="0.98" />
  <AntiAliasingStyle method="taa" quality="ultra" fallback="smaa" sharpness="0.06" />
</RenderStyle>
<!-- Neutral physical style for the opt-in Weaver offline path tracer, which
     rejects the preview-only specular="0.20" override. Kept out of the
     immediate preview by leaving every Scene's renderStyle untouched. -->
<RenderStyle id="s96_weaver">
  <SurfaceStyle shading="physical" />
  <LightingStyle ambientIntensity="1.0" ambientColor="#FFF6E8" shadowStyle="soft" />
</RenderStyle>
<Assets>
<ImageAsset id="s96_night_sky" src="texture/s96-night-sky.jpg" />
<ModelAsset id="s96_landscape" src="assets/landscape_forest__mountains.glb" />
</Assets>
