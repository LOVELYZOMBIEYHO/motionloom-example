      <Material id="skin_surface_material"
                texture="skin_surface_noise" textureAmount="0.16"
                displacement="skin_surface_noise" displacementAmount="3.2"
                roughness="0.72" specular="0.12" opacity="1" />

      <Noise id="iris_surface_noise" type="ridged" scale="18" octaves="5" seed="47"
