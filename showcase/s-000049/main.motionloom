<Graph fps={30} duration="5s" size={[1920,1080]} renderSize={[1920,1080]}>
  <Background color="#c89f86" />

  <Scene id="realistic_hazel_eye_path_study">
    <Defs>
      <LinearGradient id="skin_base" x1="0" y1="0" x2="0" y2="1"
