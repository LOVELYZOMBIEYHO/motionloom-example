<!--
=====================================================================
MAIN2 · CHARACTER 1 SIXTY-SECOND MOVEMENT CATALOG
60 s · 1920x1080 · 30 fps · one canonical GLB · twelve unique actions
=====================================================================

PURPOSE
  Turn the canonical character1.glb into a 60-second catalog: one new
  action every 5 seconds, never repeating. Each 5-second block shows a
  different embedded clip from the 43 inside the single GLB.

  BLOCK   TIME     ACTION
  ----   ------    ---------------
   01    0-5s      Idle_Talking_Loop
   02    5-10s     Walk_Loop
   03    10-15s    Walk_Formal_Loop
   04    15-20s    Jog_Fwd_Loop
   05    20-25s    Sprint_Loop
   06    25-30s    Crouch_Fwd_Loop
   07    30-35s    Roll
   08    35-40s    Punch_Jab
   09    40-45s    Sword_Attack
   10    45-50s    Spell_Simple_Shoot
   11    50-55s    Dance_Loop
   12    55-60s    Idle_Torch_Loop

  The scene owns root travel, facing, semantic head/chest accents, five
  camera cuts and a warm ember finish. Clips stay reusable and in-place.
=====================================================================
-->
<Graph fps={30} duration="60s" size={[1920,1080]} renderSize={[1920,1080]}>
  <Assets>
    <ModelAsset id="main2_character1_model"
                src="https://raw.githubusercontent.com/LOVELYZOMBIEYHO/motionloom-example/refs/heads/main/assets/sample_assets/characters/character1/character1.glb" />
    <AnimationAsset id="main2_character1_clips"
                    src="https://raw.githubusercontent.com/LOVELYZOMBIEYHO/motionloom-example/refs/heads/main/assets/sample_assets/characters/character1/character1.glb" />
  </Assets>

  <!-- Twelve unique embedded clips exposed as named, executable Actions. -->
  <Action id="main2_idle_talk" source="main2_character1_clips"
          sourceProfile="quaternius_humanoid" clip="Idle_Talking_Loop"
          skeleton="humanoid_v1" />
  <Action id="main2_walk" source="main2_character1_clips"
          sourceProfile="quaternius_humanoid" clip="Walk_Loop"
          skeleton="humanoid_v1" />
  <Action id="main2_walk_formal" source="main2_character1_clips"
          sourceProfile="quaternius_humanoid" clip="Walk_Formal_Loop"
          skeleton="humanoid_v1" />
  <Action id="main2_jog" source="main2_character1_clips"
          sourceProfile="quaternius_humanoid" clip="Jog_Fwd_Loop"
          skeleton="humanoid_v1" />
  <Action id="main2_sprint" source="main2_character1_clips"
          sourceProfile="quaternius_humanoid" clip="Sprint_Loop"
          skeleton="humanoid_v1" />
  <Action id="main2_crouch" source="main2_character1_clips"
          sourceProfile="quaternius_humanoid" clip="Crouch_Fwd_Loop"
          skeleton="humanoid_v1" />
  <Action id="main2_roll" source="main2_character1_clips"
          sourceProfile="quaternius_humanoid" clip="Roll"
          skeleton="humanoid_v1" />
  <Action id="main2_punch" source="main2_character1_clips"
          sourceProfile="quaternius_humanoid" clip="Punch_Jab"
          skeleton="humanoid_v1" />
  <Action id="main2_sword" source="main2_character1_clips"
          sourceProfile="quaternius_humanoid" clip="Sword_Attack"
          skeleton="humanoid_v1" />
  <Action id="main2_spell" source="main2_character1_clips"
          sourceProfile="quaternius_humanoid" clip="Spell_Simple_Shoot"
          skeleton="humanoid_v1" />
  <Action id="main2_dance" source="main2_character1_clips"
          sourceProfile="quaternius_humanoid" clip="Dance_Loop"
          skeleton="humanoid_v1" />
  <Action id="main2_torch" source="main2_character1_clips"
          sourceProfile="quaternius_humanoid" clip="Idle_Torch_Loop"
          skeleton="humanoid_v1" />

  <ModelProfile id="main2_character1_profile" kind="3d"
                model="main2_character1_model" preset="humanoid_v1">
    <Retarget preset="humanoid_v1">
      <Map from="pelvis" to="hips" />
      <Map from="spine_01" to="spine" />
      <Map from="spine_03" to="chest" />
      <Map from="neck_01" to="neck" />
      <Map from="Head" to="head" />
      <Map from="clavicle_l" to="shoulder_l" />
      <Map from="upperarm_l" to="upper_arm_l" />
      <Map from="lowerarm_l" to="forearm_l" />
      <Map from="hand_l" to="hand_l" />
      <Map from="clavicle_r" to="shoulder_r" />
      <Map from="upperarm_r" to="upper_arm_r" />
      <Map from="lowerarm_r" to="forearm_r" />
      <Map from="hand_r" to="hand_r" />
      <Map from="thigh_l" to="upper_leg_l" />
      <Map from="calf_l" to="lower_leg_l" />
      <Map from="foot_l" to="foot_l" />
      <Map from="ball_l" to="toe_l" />
      <Map from="thigh_r" to="upper_leg_r" />
      <Map from="calf_r" to="lower_leg_r" />
      <Map from="foot_r" to="foot_r" />
      <Map from="ball_r" to="toe_r" />
    </Retarget>
    <BoneAxisMap>
      <Axis bone="hips" turn="rotationY:1" />
      <Axis bone="spine" bend="rotationX:-1" turn="rotationY:1" />
      <Axis bone="chest" bend="rotationX:-1" turn="rotationY:1" />
      <Axis bone="neck" bend="rotationX:-1" turn="rotationY:1" />
      <Axis bone="head" bend="rotationX:-1" turn="rotationY:1" />
      <Axis bone="upper_arm_l" forward="rotationX:1" side="rotationZ:1"
            twist="rotationY:1" restForward="-4.8" restSide="-89.8" />
      <Axis bone="forearm_l" bend="rotationX:1" twist="rotationY:1" />
      <Axis bone="upper_arm_r" forward="rotationX:1" side="rotationZ:-1"
            twist="rotationY:1" restForward="-4.8" restSide="-89.8" />
      <Axis bone="forearm_r" bend="rotationX:1" twist="rotationY:1" />
      <Axis bone="upper_leg_l" forward="rotationX:-1" side="rotationZ:-1"
            twist="rotationY:1" />
      <Axis bone="lower_leg_l" bend="rotationX:-1" twist="rotationY:1" />
      <Axis bone="upper_leg_r" forward="rotationX:-1" side="rotationZ:1"
            twist="rotationY:1" />
      <Axis bone="lower_leg_r" bend="rotationX:-1" twist="rotationY:1" />
    </BoneAxisMap>
  </ModelProfile>

  <!-- Twelve non-repeating 5-second blocks, one action each. Looping clips
       fill their block; one-shot clips complete then hold their end pose. -->
  <ApplyAction target="main2_performer" action="main2_idle_talk"
               at="0s" duration="5s" loop="true" rootMotion="in_place"
               blendIn="0s" blendOut="0.3s" mask="full_body" />
  <ApplyAction target="main2_performer" action="main2_walk"
               at="5s" duration="5s" loop="true" rootMotion="in_place"
               blendIn="0.3s" blendOut="0.3s" mask="full_body" />
  <ApplyAction target="main2_performer" action="main2_walk_formal"
               at="10s" duration="5s" loop="true" rootMotion="in_place"
               blendIn="0.3s" blendOut="0.3s" mask="full_body" />
  <ApplyAction target="main2_performer" action="main2_jog"
               at="15s" duration="5s" loop="true" rootMotion="in_place"
               blendIn="0.3s" blendOut="0.3s" mask="full_body" />
  <ApplyAction target="main2_performer" action="main2_sprint"
               at="20s" duration="5s" loop="true" rootMotion="in_place"
               blendIn="0.3s" blendOut="0.3s" mask="full_body" />
  <ApplyAction target="main2_performer" action="main2_crouch"
               at="25s" duration="5s" loop="true" rootMotion="in_place"
               blendIn="0.3s" blendOut="0.3s" mask="full_body" />
  <ApplyAction target="main2_performer" action="main2_roll"
               at="30s" duration="5s" loop="false" rootMotion="in_place"
               blendIn="0.3s" blendOut="0.3s" mask="full_body" />
  <ApplyAction target="main2_performer" action="main2_punch"
               at="35s" duration="5s" loop="false" rootMotion="in_place"
               blendIn="0.3s" blendOut="0.3s" mask="full_body" />
  <ApplyAction target="main2_performer" action="main2_sword"
               at="40s" duration="5s" loop="false" rootMotion="in_place"
               blendIn="0.3s" blendOut="0.3s" mask="full_body" />
  <ApplyAction target="main2_performer" action="main2_spell"
               at="45s" duration="5s" loop="false" rootMotion="in_place"
               blendIn="0.3s" blendOut="0.3s" mask="full_body" />
  <ApplyAction target="main2_performer" action="main2_dance"
               at="50s" duration="5s" loop="true" rootMotion="in_place"
               blendIn="0.3s" blendOut="0.3s" mask="full_body" />
  <ApplyAction target="main2_performer" action="main2_torch"
               at="55s" duration="5s" loop="true" rootMotion="in_place"
               blendIn="0.3s" blendOut="0.3s" mask="full_body" />

  <Background color="#16070A" />

  <Scene id="Main2MovementRepertoire">
    <Defs>
      <LinearGradient id="main2_sky" x1="0" y1="0" x2="0" y2="1"
                      stops="0:#3D1620, 0.58:#1A0B10, 1:#0A0507" />
      <LinearGradient id="main2_floor" x1="0" y1="0" x2="0" y2="1"
                      stops="0:#48202B, 1:#120609" />
      <RadialGradient id="main2_ember" cx="0.5" cy="0.5" r="0.5"
                      stops="0:#FFD9A0, 0.25:#FF8A4C88, 1:#E8541B00" />
      <RadialGradient id="main2_flame" cx="0.5" cy="0.5" r="0.5"
                      stops="0:#FFF3D6, 0.24:#FFB46B99, 1:#FF7B2E00" />
      <RadialGradient id="main2_vignette" cx="0.5" cy="0.5" r="0.74"
                      stops="0:#00000000, 0.63:#00000022, 1:#000000C8" />
    </Defs>

    <Timeline>
      <Track id="main2_stage" space="screen" compositeOrder="10">
        <Sequence from="0s" duration="60s" out="hold">
          <Layer space="screen">
            <Rect x="0" y="0" width="1920" height="1080" fill="url(#main2_sky)" />
            <Circle x="960" y="470" radius="430" fill="url(#main2_ember)"
                    opacity={curve("0:0.08:linear, 10:0.16:ease_in_out, 20:0.1:ease_in, 30:0.22:ease_out, 40:0.12:ease_in, 50:0.3:ease_out, 60:0.14:ease_in")}
                    blend="screen" />
            <Circle x="960" y="500" radius="310" fill="url(#main2_flame)"
                    opacity={curve("0:0.05:linear, 20:0.12:ease_out, 30:0.24:ease_out, 45:0.12:ease_in, 50:0.34:ease_out, 60:0.1:ease_in")}
                    blend="screen" />

            <Rect x="0" y="735" width="1920" height="345" fill="url(#main2_floor)" />
            <Line x1="0" y1="735" x2="1920" y2="735"
                  stroke="#FFB46B" strokeWidth="5" opacity="0.5" />
            <Line x1="260" y1="1080" x2="790" y2="735"
                  stroke="#7A3A4A" strokeWidth="4" opacity="0.7" />
            <Line x1="1660" y1="1080" x2="1130" y2="735"
                  stroke="#7A3A4A" strokeWidth="4" opacity="0.7" />
            <Line x1="650" y1="1080" x2="880" y2="735"
                  stroke="#5F2C3A" strokeWidth="3" opacity="0.55" />
            <Line x1="1270" y1="1080" x2="1040" y2="735"
                  stroke="#5F2C3A" strokeWidth="3" opacity="0.55" />
            <Repeat count="7" x="0" y="0" yStep="52">
              <Line x1="330" y1="765" x2="1590" y2="765"
                    stroke="#663043" strokeWidth="3" opacity="0.34" />
            </Repeat>

            <Group opacity={curve("0:0.2:linear, 10:0.5:ease_out, 20:0.2:ease_in, 30:0.5:ease_out, 40:0.2:ease_in, 50:0.68:ease_out, 60:0.1:ease_in")}>
              <Line x1="80" y1="250" x2="610" y2="470"
                    stroke="#FFB46B" strokeWidth="7" opacity="0.5" />
              <Line x1="1840" y1="220" x2="1320" y2="470"
                    stroke="#FF7B2E" strokeWidth="7" opacity="0.44" />
              <Line x1="110" y1="870" x2="670" y2="670"
                    stroke="#FFD9A0" strokeWidth="5" opacity="0.3" />
              <Line x1="1810" y1="870" x2="1260" y2="670"
                    stroke="#E8541B" strokeWidth="5" opacity="0.3" />
            </Group>

            <Rect x="0" y="0" width="1920" height="1080"
                  fill="url(#main2_vignette)" opacity="0.76" />
          </Layer>
        </Sequence>
      </Track>

      <Track id="main2_character_track" space="3d" compositeOrder="40">
        <Sequence from="0s" duration="60s" out="hold">
          <CompositeGroup id="main2_3d_island" space="3d" depth="true" format="rgba16f">
            <Camera3D id="main2_camera_wide"
                      position={[0,0.72,5.8]} target={[0,0.46,0]}
                      up={[0,1,0]} horizonLock="true" fov="34" />
            <Camera3D id="main2_camera_track"
                      position={[-0.8,0.44,4.45]} target={[0.25,0.38,0]}
                      up={[0,1,0]} horizonLock="true" roll="-1.5" fov="31" />
            <Camera3D id="main2_camera_low"
                      position={[1.9,-0.02,4.2]} target={[0.45,0.3,0]}
                      up={[0,1,0]} horizonLock="true" roll="2" fov="29" />
            <Camera3D id="main2_camera_close"
                      position={[0.55,0.72,3.9]} target={[0.2,0.56,0]}
                      up={[0,1,0]} horizonLock="true" fov="29" />
            <Camera3D id="main2_camera_top"
                      position={[0,2.1,3.4]} target={[0,0.5,0]}
                      up={[0,1,0]} horizonLock="true" fov="40" />

            <Model id="main2_performer"
                   asset="main2_character1_model"
                   profile="main2_character1_profile"
                   position={[-1.7,-0.62,0]}
                   rotationY="0"
                   scaleMode="normalize_height"
                   scale="1.3"
                   exposure="1.8" />
          </CompositeGroup>
        </Sequence>
      </Track>

      <Track id="main2_hud" space="screen" compositeOrder="60">
        <Sequence from="0s" duration="60s" out="hold">
          <Layer space="screen">
            <Text x="68" y="76" value="CHARACTER 1 / 60-SECOND MOVEMENT CATALOG"
                  fontFamily="Arial" fontSize="27" fontWeight="800"
                  tracking="7" color="#FFF4E8" />
            <Text x="70" y="116" value="ONE GLB · 12 UNIQUE ACTIONS · NO REPEATS"
                  fontFamily="Arial" fontSize="14" fontWeight="700"
                  tracking="5" color="#FFB46B" />
            <Line x1="70" y1="142" x2="560" y2="142"
                  stroke="#FFB46B" strokeWidth="3" opacity="0.68" />

            <Group opacity={curve("0:1:linear, 4.6:1:linear, 5:0:ease_in")}>
              <Text x="70" y="960" value="01 / IDLE TALK"
                    fontFamily="Arial" fontSize="22" fontWeight="800" tracking="5" color="#FFF4E8" />
            </Group>
            <Group opacity={curve("0:0:linear, 5:0:linear, 5.3:1:ease_out, 9.6:1:linear, 10:0:ease_in")}>
              <Text x="70" y="960" value="02 / WALK"
                    fontFamily="Arial" fontSize="22" fontWeight="800" tracking="5" color="#FFD9A0" />
            </Group>
            <Group opacity={curve("0:0:linear, 10:0:linear, 10.3:1:ease_out, 14.6:1:linear, 15:0:ease_in")}>
              <Text x="70" y="960" value="03 / FORMAL WALK"
                    fontFamily="Arial" fontSize="22" fontWeight="800" tracking="5" color="#FFC48A" />
            </Group>
            <Group opacity={curve("0:0:linear, 15:0:linear, 15.3:1:ease_out, 19.6:1:linear, 20:0:ease_in")}>
              <Text x="70" y="960" value="04 / JOG"
                    fontFamily="Arial" fontSize="22" fontWeight="800" tracking="5" color="#FF9E64" />
            </Group>
            <Group opacity={curve("0:0:linear, 20:0:linear, 20.3:1:ease_out, 24.6:1:linear, 25:0:ease_in")}>
              <Text x="70" y="960" value="05 / SPRINT"
                    fontFamily="Arial" fontSize="22" fontWeight="800" tracking="5" color="#FF8A4C" />
            </Group>
            <Group opacity={curve("0:0:linear, 25:0:linear, 25.3:1:ease_out, 29.6:1:linear, 30:0:ease_in")}>
              <Text x="70" y="960" value="06 / CROUCH WALK"
                    fontFamily="Arial" fontSize="22" fontWeight="800" tracking="5" color="#FFB46B" />
            </Group>
            <Group opacity={curve("0:0:linear, 30:0:linear, 30.3:1:ease_out, 34.6:1:linear, 35:0:ease_in")}>
              <Text x="70" y="960" value="07 / COMBAT ROLL"
                    fontFamily="Arial" fontSize="22" fontWeight="800" tracking="5" color="#FFD9A0" />
            </Group>
            <Group opacity={curve("0:0:linear, 35:0:linear, 35.3:1:ease_out, 39.6:1:linear, 40:0:ease_in")}>
              <Text x="70" y="960" value="08 / PUNCH JAB"
                    fontFamily="Arial" fontSize="22" fontWeight="800" tracking="5" color="#FF8A4C" />
            </Group>
            <Group opacity={curve("0:0:linear, 40:0:linear, 40.3:1:ease_out, 44.6:1:linear, 45:0:ease_in")}>
              <Text x="70" y="960" value="09 / SWORD ATTACK"
                    fontFamily="Arial" fontSize="22" fontWeight="800" tracking="5" color="#FFC48A" />
            </Group>
            <Group opacity={curve("0:0:linear, 45:0:linear, 45.3:1:ease_out, 49.6:1:linear, 50:0:ease_in")}>
              <Text x="70" y="960" value="10 / SPELL RELEASE"
                    fontFamily="Arial" fontSize="22" fontWeight="800" tracking="5" color="#F1BEFF" />
            </Group>
            <Group opacity={curve("0:0:linear, 50:0:linear, 50.3:1:ease_out, 54.6:1:linear, 55:0:ease_in")}>
              <Text x="70" y="960" value="11 / DANCE"
                    fontFamily="Arial" fontSize="22" fontWeight="800" tracking="5" color="#FFD9A0" />
            </Group>
            <Group opacity={curve("0:0:linear, 55:0:linear, 55.3:1:ease_out, 60:1:linear")}>
              <Text x="70" y="960" value="12 / TORCH FINALE"
                    fontFamily="Arial" fontSize="22" fontWeight="800" tracking="5" color="#FFF3D6" />
            </Group>

            <Text x="1850" y="960" value="MAIN2" align="right"
                  fontFamily="Arial" fontSize="18" fontWeight="800"
                  tracking="6" color="#7A4A4A" />
          </Layer>
        </Sequence>
      </Track>
    </Timeline>

    <Effects>
      <Effect process="Main2Finish" />
    </Effects>
  </Scene>

  <!-- Actor root choreography: clips stay reusable and in-place; the scene
       walks the actor across the stage once per 5-second block. -->
  <AnimationTarget node="main2_performer" property="position">
    <Key time="0s" value="[-1.7,-0.62,0]" />
    <Key time="5s" value="[-1.35,-0.62,0]" ease="ease_in_out" />
    <Key time="10s" value="[-1,-0.62,0]" ease="ease_in_out" />
    <Key time="15s" value="[-0.65,-0.62,0]" ease="ease_in_out" />
    <Key time="20s" value="[-0.3,-0.62,0]" ease="ease_in_out" />
    <Key time="25s" value="[0.05,-0.62,0]" ease="ease_in_out" />
    <Key time="30s" value="[0.4,-0.62,0]" ease="ease_in_out" />
    <Key time="35s" value="[0.68,-0.62,0]" ease="ease_in_out" />
    <Key time="40s" value="[0.85,-0.62,0]" ease="ease_in_out" />
    <Key time="45s" value="[0.85,-0.62,0]" ease="ease_in_out" />
    <Key time="50s" value="[0.6,-0.62,0]" ease="ease_in_out" />
    <Key time="55s" value="[0.25,-0.62,0]" ease="ease_in_out" />
    <Key time="60s" value="[0.25,-0.62,0]" />
  </AnimationTarget>
  <AnimationTarget node="main2_performer" property="rotationY">
    <Key time="0s" value="0" />
    <Key time="5s" value="-10" ease="ease_in_out" />
    <Key time="10s" value="8" ease="ease_in_out" />
    <Key time="15s" value="-12" ease="ease_in_out" />
    <Key time="20s" value="10" ease="ease_in_out" />
    <Key time="25s" value="-8" ease="ease_in_out" />
    <Key time="30s" value="14" ease="ease_in_out" />
    <Key time="35s" value="-14" ease="ease_in_out" />
    <Key time="40s" value="10" ease="ease_in_out" />
    <Key time="45s" value="6" ease="ease_in_out" />
    <Key time="50s" value="0" ease="ease_in_out" />
    <Key time="55s" value="-8" ease="ease_in_out" />
    <Key time="60s" value="-8" />
  </AnimationTarget>

  <!-- Semantic bone channels layer eye-line and torso accents over the baked
       clips without editing character1.glb. -->
  <AnimationTarget node="main2_performer" property="bones.head.rotationY">
    <Key time="0s" value="0" />
    <Key time="2.5s" value="-12" ease="ease_in_out" />
    <Key time="5s" value="8" ease="ease_in_out" />
    <Key time="10s" value="-10" ease="ease_in_out" />
    <Key time="15s" value="9" ease="ease_in_out" />
    <Key time="20s" value="-8" ease="ease_in_out" />
    <Key time="25s" value="10" ease="ease_in_out" />
    <Key time="30s" value="-12" ease="ease_in_out" />
    <Key time="35s" value="10" ease="ease_in_out" />
    <Key time="40s" value="-12" ease="ease_in_out" />
    <Key time="45s" value="8" ease="ease_in_out" />
    <Key time="50s" value="-8" ease="ease_in_out" />
    <Key time="55s" value="6" ease="ease_in_out" />
    <Key time="60s" value="0" ease="ease_in_out" />
  </AnimationTarget>
  <AnimationTarget node="main2_performer" property="bones.chest.rotationZ">
    <Key time="0s" value="0" />
    <Key time="10s" value="-4" ease="ease_out" />
    <Key time="15s" value="4" ease="ease_in_out" />
    <Key time="20s" value="-5" ease="ease_out" />
    <Key time="25s" value="4" ease="ease_in_out" />
    <Key time="30s" value="-4" ease="ease_out" />
    <Key time="35s" value="5" ease="ease_in_out" />
    <Key time="40s" value="-5" ease="ease_out" />
    <Key time="45s" value="4" ease="ease_in_out" />
    <Key time="50s" value="-4" ease="ease_out" />
    <Key time="55s" value="0" ease="ease_in_out" />
    <Key time="60s" value="0" ease="ease_in_out" />
  </AnimationTarget>

  <!-- Five cameras, one cut per 5-second block. -->
  <AnimationTarget node="Main2MovementRepertoire" property="activeCamera">
    <Key time="0s" value="main2_camera_wide" />
    <Key time="5s" value="main2_camera_track" />
    <Key time="10s" value="main2_camera_low" />
    <Key time="15s" value="main2_camera_close" />
    <Key time="20s" value="main2_camera_top" />
    <Key time="25s" value="main2_camera_wide" />
    <Key time="30s" value="main2_camera_track" />
    <Key time="35s" value="main2_camera_low" />
    <Key time="40s" value="main2_camera_close" />
    <Key time="45s" value="main2_camera_top" />
    <Key time="50s" value="main2_camera_wide" />
    <Key time="55s" value="main2_camera_close" />
  </AnimationTarget>

  <AnimationTarget node="main2_camera_track" property="position">
    <Key time="0s" value="[-0.8,0.44,4.45]" />
    <Key time="30s" value="[0.55,0.52,4.15]" ease="ease_in_out" />
    <Key time="60s" value="[0.55,0.52,4.15]" />
  </AnimationTarget>
  <AnimationTarget node="main2_camera_close" property="target">
    <Key time="0s" value="[0.2,0.56,0]" />
    <Key time="15s" value="[0.05,0.58,0]" ease="ease_in_out" />
    <Key time="40s" value="[0.4,0.58,0]" ease="ease_in_out" />
    <Key time="60s" value="[0.25,0.5,0]" ease="ease_in_out" />
  </AnimationTarget>

  <Process id="Main2Finish">
    <Tex id="main2_scene_tex" fmt="rgba16f" from="scene" />
    <Tex id="main2_bloom_tex" fmt="rgba16f" />
    <Tex id="main2_final_tex" fmt="rgba16f" />
    <Pass id="main2_bloom" kind="compute" effect="glow_bloom"
          in={["main2_scene_tex"]} out={["main2_bloom_tex"]}
          params={{ threshold: "0.44", intensity: "0.36", sigma: "5.4" }} />
    <Pass id="main2_grain" kind="compute" effect="film_grain"
          in={["main2_bloom_tex"]} out={["main2_final_tex"]}
          params={{ kind: "film_grain", amount: "0.008", scale: "1.0", seed: "72" }} />
  </Process>

  <AnimationTarget node="main2_bloom" property="params.intensity">
    <Key time="0s" value="0.28" />
    <Key time="10s" value="0.38" ease="ease_in_out" />
    <Key time="20s" value="0.3" ease="ease_in" />
    <Key time="30s" value="0.5" ease="ease_out" />
    <Key time="40s" value="0.34" ease="ease_in" />
    <Key time="45s" value="0.58" ease="ease_out" />
    <Key time="50s" value="0.36" ease="ease_in" />
    <Key time="55s" value="0.5" ease="ease_out" />
    <Key time="60s" value="0.36" ease="ease_in" />
  </AnimationTarget>

  <Present from="Main2MovementRepertoire" />
</Graph>
