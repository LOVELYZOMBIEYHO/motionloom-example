                    tracking="5" color="#FFF3DE" />
              <Text x="71" y="108" value="S92 · MESHASSET PROPS · 100M SPRINT FINISH"
                    fontFamily="Arial" fontSize="11" fontWeight="700"
                    tracking="2.4" color="#FFC46A" />
            </Group>
          </Layer>
        </Sequence>
