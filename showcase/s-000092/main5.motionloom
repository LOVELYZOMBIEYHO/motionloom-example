                    boundsMin={[3.0,0.6,-2.6]} boundsMax={[6.6,4.8,2.6]}
                    velocity={[0.12,-1.05,0.06]} lifetime="3.4s"
                    phase="random" respawn="random" scaleRange={[0.7,1.5]}>
