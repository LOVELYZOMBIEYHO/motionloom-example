  <!-- ── World travel: in-place runs, deterministic position tracks ── -->
  <AnimationTarget node="s92_hero_a" property="position">
    <Key time="0s" value="[-45.55,0,0]" />
    <Key time="9.353s" value="[2.0,0,0]" ease="linear" />
    <Key time="10.353s" value="[7.08,0,0]" ease="linear" />
    <Key time="10.553s" value="[7.86,0,0]" ease="ease_out" />
    <Key time="12s" value="[11.68,0,0]" ease="linear" />
  </AnimationTarget>

  <!-- Infield photographer: low dolly plus a sprint pan, he passes mid-shot. -->
  <AnimationTarget node="s92_cam_photo" property="position">
    <Key time="3s" value="[-23,1.35,5.8]" />
    <Key time="6s" value="[-15,1.55,6.4]" ease="linear" />
  </AnimationTarget>
  <AnimationTarget node="s92_cam_photo" property="target">
    <Key time="3s" value="[-29.9,1.30,0]" />
    <Key time="6s" value="[-14.6,1.30,0]" ease="linear" />
  </AnimationTarget>

  <!-- Finish camera: meets the sprinter through the arch and gives him room. -->
  <AnimationTarget node="s92_cam_front" property="position">
    <Key time="9s" value="[10,1.85,3.4]" />
    <Key time="12s" value="[17.2,1.72,3.0]" ease="ease_in_out" />
  </AnimationTarget>
  <AnimationTarget node="s92_cam_front" property="target">
    <Key time="9s" value="[3.5,1.35,0.3]" />
    <Key time="12s" value="[11.7,1.28,0.2]" ease="ease_in_out" />
  </AnimationTarget>


  <!-- The three-beat edit. -->
  <AnimationTarget node="S92TheLastBaton" property="activeCamera">
    <Key time="0s" value="s92_cam_pov" />
    <Key time="3s" value="s92_cam_photo" />
    <Key time="6s" value="s92_cam_pov" />
    <Key time="9s" value="s92_cam_front" />
  </AnimationTarget>

  <!-- Bloom flares at the tape break and blooms wide for the raise. -->
  <AnimationTarget node="s92_bloom" property="params.intensity">
    <Key time="0s" value="0.16" />
    <Key time="9.0s" value="0.18" />
    <Key time="9.353s" value="0.34" ease="ease_out" />
    <Key time="10.4s" value="0.20" ease="ease_in" />
    <Key time="11.4s" value="0.28" ease="ease_out" />
    <Key time="12s" value="0.20" />
  </AnimationTarget>

  <Process id="S92Finish">
    <Tex id="s92_scene_tex" fmt="rgba16f" from="scene" />
    <Tex id="s92_bloom_tex" fmt="rgba16f" />
    <Tex id="s92_final_tex" fmt="rgba16f" />
    <Pass id="s92_bloom" kind="compute" effect="glow_bloom"
          in={["s92_scene_tex"]} out={["s92_bloom_tex"]}
          params={{ threshold: "0.6", intensity: "0.16", sigma: "4.0" }} />
    <Pass id="s92_grain" kind="compute" effect="film_grain"
          in={["s92_bloom_tex"]} out={["s92_final_tex"]}
          params={{ kind: "film_grain", amount: "0.005", scale: "1.0", seed: "92" }} />
  </Process>

  <Present from="S92TheLastBaton" />
</Graph>
