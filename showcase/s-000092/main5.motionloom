  <ActionLibrary id="s92_walk_stop"
                 src="../../assets/action_libraries/landing_page/standard-walk.motionloom"
                 actions={["standard_walk_stop"]} />
  <ActionLibrary id="s92_wave"
                 src="../../assets/action_libraries/landing_page/wave-greeting.motionloom"
                 actions={["wave_greeting"]} />
  <ActionLibrary id="s92_idle"
                 src="../../assets/action_libraries/landing_page/listening-idle.motionloom"
                 actions={["listening_idle_loop"]} />

  <!-- Hero: sprint the straight, hold race pace for one beat past the tape,
       then crossfade through an authored handoff into the slow run. -->
  <ApplyAction target="s92_hero_a" action="s92_sprint.sprint_standard_loop"
               at="0s" duration="10.353s" loop="true" speed="1.0"
               rootMotion="in_place" blendIn="0s" blendOut="0s"
               mask="full_body" ground="s92_track_top"
               floorSnap="0.08" safeMargin="0.01" sweepStep="0.03" />
  <ApplyAction target="s92_hero_a" action="s92_handoff.sprint_to_slow_run_handoff"
               at="10.353s" duration="0.200s" loop="false"
               rootMotion="in_place" blendIn="0s" blendOut="0s"
               mask="full_body" ground="s92_track_top"
               floorSnap="0.08" safeMargin="0.01" sweepStep="0.03" />
  <ApplyAction target="s92_hero_a" action="s92_slow.slow_run_standard_loop"
               at="10.553s" duration="1.447s" loop="true" speed="1.0"
               rootMotion="in_place" blendIn="0s" blendOut="0s"
               mask="full_body" ground="s92_track_top"
               floorSnap="0.08" safeMargin="0.01" sweepStep="0.03" />

  <!-- ── Attachments: the baton lives in the hero's right palm ─────── -->
  <Attachment id="s92_baton_core_grip" object="s92_baton_core_m">
    <Socket id="palm" position={[0,0.05,0]} rotation={[55,0,50]} />
    <Attach socket="palm" target="s92_hero_a.hand_r"
            mode="snap" drive="object"
            positionWeight="1" rotationWeight="1" />
  </Attachment>
  <Attachment id="s92_baton_grip_mount" object="s92_baton_grip_m">
    <Socket id="palm" position={[0,0.05,0]} rotation={[55,0,50]} />
    <Attach socket="palm" target="s92_hero_a.hand_r"
            mode="snap" drive="object"
            positionWeight="1" rotationWeight="1" />
  </Attachment>

