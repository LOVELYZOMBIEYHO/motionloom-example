<Graph fps={30} duration="4s" size={[640,360]} renderSize={[640,360]}>
  <Background color="#020617" />

  <Scene id="weighted_repeat_core">
    <Timeline>
      <Track id="weighted_repeat_track" space="screen" z="0">
        <Sequence from="0s" duration="4s" out="hold">
          <Layer id="weighted_repeat_layer">
            <Text x="320" y="42" value="WEIGHTED VARIANTS + VARY"
                  fontSize="20" fontWeight="900" color="#F8FAFC" />
            <Rect x="35" y="70" width="570" height="250" radius="24"
                  color="#081426" stroke="#1E3A5F" strokeWidth="2" />
            <Repeat id="mixed_particles" count="72" distribution="scatter"
                    bounds={[55,90,530,205]} seed="52052">
              <Variants choose="weighted" seed="8052">
                <Circle x="0" y="0" radius="7" color="#FFFFFF" weight="5" />
                <Rect x="-7" y="-7" width="14" height="14"
                      radius="2" color="#FFFFFF" weight="2" />
                <Path d="M 0 -10 L 8 8 L -8 8 Z" fill="#FFFFFF" weight="1" />
              </Variants>
              <Vary property="color"
                    values={["#22D3EE","#A3E635","#F472B6","#FDE047"]} />
              <Vary property="scale" range={[0.55,1.65]} />
              <Vary property="rotation" range={[-35,35]} />
              <Vary property="opacity" range={[0.35,1]} />
            </Repeat>
          </Layer>
        </Sequence>
      </Track>
    </Timeline>
  </Scene>

  <Present from="weighted_repeat_core" />
</Graph>
