<Graph fps={30} duration="3s" size={[640,360]} renderSize={[640,360]}>
  <Background color="#10141D" />
  <Scene id="BonePuppetCore">
    <Timeline>
      <Track id="bone_puppet_track" space="screen" z="0">
        <Sequence from="0s" duration="3s" out="hold">
          <Layer>
            <Group id="rigged_arm">
              <Line x1="210" y1="95" x2="300" y2="185"
                    stroke="#61739B" strokeWidth="64" lineCap="round" />
              <Line x1="300" y1="185" x2="430" y2="230"
                    stroke="#F8DDCC" strokeWidth="54" lineCap="round" />
              <Circle x="300" y="185" radius="32" color="#53658C" />
              <Circle x="430" y="230" radius="34" color="#F8DDCC" />
            </Group>

            <PuppetWarp id="arm_bone_warp" target="rigged_arm"
                        solver="bones" bend="auto" stretch="0"
                        jointSoftness="32" preserveVolume="true"
                        width="640" height="360" density="12x8">
              <MeshTopology id="arm_bone_mesh">
                <Vertex id="a_l" x="187" y="118" bone="upper" />
                <Vertex id="a_c" x="210" y="95" bone="upper" />
                <Vertex id="a_r" x="233" y="72" bone="upper" />
                <Vertex id="ju_l" x="277" y="208" bone="upper" />
                <Vertex id="ju_c" x="300" y="185" bone="upper" />
                <Vertex id="ju_r" x="323" y="162" bone="upper" />
                <Vertex id="jf_l" x="289" y="216" bone="forearm" />
                <Vertex id="jf_c" x="300" y="185" bone="forearm" />
                <Vertex id="jf_r" x="311" y="154" bone="forearm" />
                <Vertex id="w_l" x="420" y="258" bone="forearm" />
                <Vertex id="w_c" x="430" y="230" bone="forearm" />
                <Vertex id="w_r" x="440" y="202" bone="forearm" />
                <Vertex id="h_l" x="462" y="271" bone="hand" />
                <Vertex id="h_c" x="474" y="245" bone="hand" />
                <Vertex id="h_r" x="484" y="217" bone="hand" />
                <Vertex id="j_c" x="300" y="185" bone="joint" />
                <Vertex id="j_0" x="300" y="153" bone="joint" />
                <Vertex id="j_1" x="323" y="162" bone="joint" />
                <Vertex id="j_2" x="332" y="185" bone="joint" />
                <Vertex id="j_3" x="323" y="208" bone="joint" />
                <Vertex id="j_4" x="300" y="217" bone="joint" />
                <Vertex id="j_5" x="277" y="208" bone="joint" />
                <Vertex id="j_6" x="268" y="185" bone="joint" />
                <Vertex id="j_7" x="277" y="162" bone="joint" />

                <Triangle id="u0" a="a_l" b="a_c" c="ju_c" />
                <Triangle id="u1" a="a_l" b="ju_c" c="ju_l" />
                <Triangle id="u2" a="a_c" b="a_r" c="ju_r" />
                <Triangle id="u3" a="a_c" b="ju_r" c="ju_c" />
                <Triangle id="f0" a="jf_l" b="jf_c" c="w_c" />
                <Triangle id="f1" a="jf_l" b="w_c" c="w_l" />
                <Triangle id="f2" a="jf_c" b="jf_r" c="w_r" />
                <Triangle id="f3" a="jf_c" b="w_r" c="w_c" />
                <Triangle id="h0" a="w_l" b="w_c" c="h_c" />
                <Triangle id="h1" a="w_l" b="h_c" c="h_l" />
                <Triangle id="h2" a="w_c" b="w_r" c="h_r" />
                <Triangle id="h3" a="w_c" b="h_r" c="h_c" />
                <Triangle id="j0" a="j_c" b="j_0" c="j_1" />
                <Triangle id="j1" a="j_c" b="j_1" c="j_2" />
                <Triangle id="j2" a="j_c" b="j_2" c="j_3" />
                <Triangle id="j3" a="j_c" b="j_3" c="j_4" />
                <Triangle id="j4" a="j_c" b="j_4" c="j_5" />
                <Triangle id="j5" a="j_c" b="j_5" c="j_6" />
                <Triangle id="j6" a="j_c" b="j_6" c="j_7" />
                <Triangle id="j7" a="j_c" b="j_7" c="j_0" />
              </MeshTopology>
              <PuppetPin id="shoulder" role="anchor" vertex="a_c"
                         x="210" y="95" targetX="210" targetY="95"
                         fixed="true" radius="32" />
              <PuppetPin id="elbow" role="joint" vertex="jf_c"
                         x="300" y="185" targetX="300" targetY="185"
                         radius="32" />
              <PuppetPin id="wrist" role="control" vertex="w_c"
                         x="430" y="230"
                         targetX={curve("0:430:linear, 1.5:355:ease_in_out, 3:430:ease_in_out")}
                         targetY={curve("0:230:linear, 1.5:105:ease_in_out, 3:230:ease_in_out")}
                         radius="32" />
            </PuppetWarp>
          </Layer>
        </Sequence>
      </Track>
    </Timeline>
  </Scene>
  <Present from="BonePuppetCore" />
</Graph>
