<Graph fps={30} duration="4s" size={[640,360]}>
  <Background color="#121A16" />
  <Scene id="capsule_collision">
    <Defs>
      <Collider id="shoulder" target="capsule_motion" shape="capsule" from={[-125,0]} to={[125,0]} radius="42" />
      <Wind id="capsule_wind" direction={[-1,-0.15]} strength="135" turbulence="0.8" noiseScale="2.8" />
    </Defs>
    <Timeline>
      <Track>
        <Sequence from="0s" duration="4s">
          <Layer>
        <Group id="capsule_motion"
               x={curve("0:345:linear, 4:345:linear")}
               y={curve("0:330:ease_in_out, 1.5:235:ease_in_out, 2.8:190:ease_in_out, 4:330:ease_in_out")}>
          <Line x1="-125" y1="0" x2="125" y2="0" stroke="#4ADE80" strokeWidth="84" />
        </Group>
        <Curve id="capsule_curve" points="190,50 230,90 280,130 330,170" stroke="#FEF3C7" strokeWidth="16" />
        <SpringChain target="capsule_curve" pin="start" segments="20" stiffness="0.76" damping="0.08" gravity={[0,600]} wind="capsule_wind" colliders={["shoulder"]} collisionRadius="8" />
          </Layer>
        </Sequence>
      </Track>
    </Timeline>
  </Scene>
  <Present from="capsule_collision" />
</Graph>
