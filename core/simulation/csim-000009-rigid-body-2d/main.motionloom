<Graph fps={30} duration="4s" size={[640,360]}>
  <Background color="#111827" />
  <Scene id="rigid_body_contract">
    <Timeline>
      <Track>
        <Sequence from="0s" duration="4s">
          <Layer>
            <Group id="body"
                   x={curve("0:0:linear, 1.2:80:ease_out, 2.4:-35:ease_in_out, 4:0:ease_in_out")}
                   y={curve("0:0:linear, 1.2:-45:ease_out, 2.4:20:ease_in_out, 4:0:ease_in_out")}>
              <Rect x="260" y="120" width="120" height="80" radius="18" color="#FB7185" />
            </Group>
            <RigidBody2D id="body_physics" target="body" mass="2" velocity={[90,0]} angularVelocity="0.8" />
